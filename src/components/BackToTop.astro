---
import { ui, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].common;
---

<button class="back-to-top" type="button" aria-label={t.backToTop} title={t.backToTop} data-back-to-top>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 19V5m0 0L6.5 10.5M12 5l5.5 5.5"></path>
  </svg>
  <span>{t.top}</span>
</button>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let scrollFrame: number | undefined;
  let footerIsVisible = false;
  let footerObserver: IntersectionObserver | undefined;

  const updateBackToTop = () => {
    scrollFrame = undefined;

    const button = document.querySelector<HTMLElement>('[data-back-to-top]');
    if (!button) return;

    const showAfter = Math.max(360, window.innerHeight * 0.7);
    button.classList.toggle('is-visible', window.scrollY > showAfter && !footerIsVisible);
  };

  const observeFooter = () => {
    footerObserver?.disconnect();
    footerIsVisible = false;

    const footer = document.querySelector<HTMLElement>('.site-footer');
    if (!footer) return;

    footerObserver = new IntersectionObserver(([entry]) => {
      footerIsVisible = entry?.isIntersecting ?? false;
      updateBackToTop();
    });
    footerObserver.observe(footer);
  };

  const queueBackToTopUpdate = () => {
    if (scrollFrame !== undefined) return;
    scrollFrame = window.requestAnimationFrame(updateBackToTop);
  };

  document.addEventListener('astro:page-load', () => {
    observeFooter();
    updateBackToTop();
  });
  window.addEventListener('scroll', queueBackToTopUpdate, { passive: true });
  window.addEventListener('resize', queueBackToTopUpdate, { passive: true });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (!event.target.closest('[data-back-to-top]')) return;

    window.scrollTo({
      top: 0,
      behavior: reducedMotion.matches ? 'auto' : 'smooth',
    });
  });
</script>

<style>
  .back-to-top {
    position: fixed;
    inset-inline-end: max(var(--space-lg), env(safe-area-inset-right));
    inset-block-end: max(var(--space-lg), env(safe-area-inset-bottom));
    z-index: var(--layer-back-to-top);
    width: var(--size-back-to-top);
    height: var(--size-back-to-top);
    padding: var(--back-to-top-padding);
    border: var(--rule-hair) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    box-shadow: var(--shadow-back-to-top-offset) var(--color-accent);
    color: var(--color-paper);
    cursor: pointer;
    display: grid;
    place-items: center;
    gap: var(--back-to-top-label-gap);
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--space-md)) scale(var(--back-to-top-rest-scale));
    visibility: hidden;
    transition:
      opacity var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out),
      visibility var(--dur-short),
      box-shadow var(--dur-micro) var(--ease-out),
      background-color var(--dur-long) var(--ease-in-out),
      color var(--dur-long) var(--ease-in-out);
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  .back-to-top svg {
    width: var(--size-back-to-top-icon);
    height: var(--size-back-to-top-icon);
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.65;
  }

  .back-to-top span {
    font-family: var(--font-mono);
    font-size: var(--size-back-to-top-label);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-none);
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .back-to-top:hover {
      box-shadow: var(--shadow-back-to-top-hover-offset) var(--color-accent);
      transform: translate(var(--back-to-top-hover-offset), var(--back-to-top-hover-offset));
    }
  }

  .back-to-top:active {
    box-shadow: var(--shadow-back-to-top-active-offset) var(--color-accent);
    transform: translate(var(--back-to-top-active-offset), var(--back-to-top-active-offset));
  }

  @media (max-width: 39.99rem) {
    .back-to-top {
      inset-inline-end: max(var(--space-md), env(safe-area-inset-right));
      inset-block-end: max(var(--space-md), env(safe-area-inset-bottom));
      width: var(--size-back-to-top-compact);
      height: var(--size-back-to-top-compact);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transform: none;
    }

    .back-to-top:hover,
    .back-to-top:active {
      transform: none;
    }
  }
</style>
