---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { copy, ui, type Lang } from '../i18n/content';
import Icon from './Icon.astro';
import PortfolioMotion from './PortfolioMotion.astro';
import '../styles/developer.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang].dev;
---
<div class="experience experience--developer" data-experience-panel="developer">
  <main id="main" class="developer-home">
    <section class="developer-hero page-shell" aria-labelledby="developer-title">
      <div class="developer-hero__copy">
        <p class="developer-hero__role" data-hero-reveal>{t.currentValue}</p>
        <h1 id="developer-title" data-hero-reveal>{t.title.split('\n').map((line) => <span>{line}</span>)}</h1>
        <p class="developer-hero__intro" data-hero-reveal>{t.intro}</p>
        <div class="portfolio-actions" data-hero-reveal>
          <a class="button button--primary" href="mailto:davidbarbosa.dev@gmail.com">{t.secondaryCta}<Icon name="arrow-up-right" /></a>
          <a class="text-link" href="/david-barbosa-resume.pdf" target="_blank" rel="noreferrer">{copy[lang].footer.resume}<Icon name="arrow-up-right" /><span class="sr-only"> ({ui[lang].common.opensInNewTab})</span></a>
        </div>
      </div>
      <figure class="developer-hero__portrait" data-hero-image>
        <Image src={portrait} width={800} widths={[320, 480, 640, 800]} sizes="(min-width: 1024px) 30vw, 88vw" quality={80} loading="eager" fetchpriority="high" alt="David Barbosa" />
      </figure>
    </section>
    <section class="developer-about page-shell" id="about" tabindex="-1">
      <div class="developer-about__copy" data-reveal><h2>{t.aboutTitle}</h2><div class="developer-about__body">{t.aboutBody.split(/(?<=\.)\s+/).map((paragraph) => <p>{paragraph}</p>)}</div></div>
      <dl class="developer-profile" data-reveal>
        <div><dt>{t.current}</dt><dd>{t.currentValue}</dd></div>
        <div><dt>{t.location}</dt><dd>{t.locationValue}</dd></div>
        <div><dt>{t.focus}</dt><dd class="developer-profile__focus">{t.focusValue.split(' · ').map((item) => <span>{item}</span>)}</dd></div>
      </dl>
    </section>
    <section class="developer-career page-shell" aria-labelledby="experience-title">
      <h2 id="experience-title" data-reveal>{t.experienceTitle}</h2>
      <div class="developer-career__history">
        {t.experience.map(([date, company, role], index) => (
          <article data-reveal data-reveal-order={index}><p class="developer-career__date">{date}</p><h3>{company}</h3><p>{role}</p></article>
        ))}
      </div>
    </section>
    <section class="developer-contact page-shell" id="contact" aria-labelledby="contact-title" tabindex="-1" data-reveal>
      <h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p>
      <a class="button button--primary" href="mailto:davidbarbosa.dev@gmail.com">{t.contactLink}<Icon name="arrow-up-right" /></a>
    </section>
  </main>
  <PortfolioMotion />
</div>
