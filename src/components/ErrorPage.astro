---
import { Image } from 'astro:assets';
import background from '../assets/bg_dark.jpg';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { copy, ui, type ErrorCode, type Lang, type UiCopy } from '../i18n/content';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  code: ErrorCode;
}

const { code } = Astro.props;
const isNotFound = code === '404';
type ErrorTranslation = {
  ui: UiCopy;
  modes: { developer: string; photographer: string };
  theme: { light: string; dark: string };
};
const getErrorTranslation = (language: Lang): ErrorTranslation => ({
  ui: ui[language],
  modes: copy[language].modes,
  theme: copy[language].theme,
});
const translations = {
  en: getErrorTranslation('en'),
  es: getErrorTranslation('es'),
} satisfies Record<Lang, ErrorTranslation>;
const initial = translations.en.ui.error.errors[code];
const pageTitle = `${code} — ${initial.title} — David Barbosa`;
---

<SiteLayout
  lang="en"
  title={pageTitle}
  description={initial.description}
  indexable={false}
  localized={false}
  includeStructuredData={false}
>
  <SiteHeader lang="en" languageHref="?lang=es" />

  <main
    id="main"
    class="error-page"
    data-error-code={code}
    data-error-translations={JSON.stringify(translations)}
  >
    <Image
      class="error-page__background"
      src={background}
      alt=""
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
    <div class="error-page__shade" aria-hidden="true"></div>

    <section class="error-page__content" aria-labelledby="error-title">
      <p class="error-page__code">Error / {code}</p>
      <h1 id="error-title" data-error-title>{initial.title}</h1>
      <p class="error-page__message" data-error-message>{initial.description}</p>

      <nav class="error-page__actions" aria-label={translations.en.ui.error.actionsLabel} data-error-actions>
        {isNotFound ? (
          <a class="button" href="/en/dev/" data-error-primary>{initial.primary}</a>
        ) : (
          <button class="button" type="button" data-error-primary data-error-retry>{initial.primary}</button>
        )}
        {!isNotFound && <a class="text-link" href="/en/dev/" data-error-developer>{translations.en.modes.developer}</a>}
        <a class="text-link" href="/en/ph/" data-error-photography>{translations.en.modes.photographer}</a>
      </nav>
    </section>
  </main>

  <SiteFooter lang="en" />
</SiteLayout>

<script>
  import type { ErrorCode, Lang as ErrorLanguage, UiCopy } from '../i18n/content';

  interface ErrorTranslation {
    ui: UiCopy;
    modes: { developer: string; photographer: string };
    theme: { light: string; dark: string };
  }

  const isErrorLanguage = (value: string | null): value is ErrorLanguage =>
    value === 'en' || value === 'es';

  const getErrorLanguage = (): ErrorLanguage => {
    const url = new URL(window.location.href);
    const queryLanguage = url.searchParams.get('lang');
    if (isErrorLanguage(queryLanguage)) return queryLanguage;

    const pathLanguage = url.pathname.split('/').filter(Boolean)[0] ?? null;
    if (isErrorLanguage(pathLanguage)) return pathLanguage;

    return window.navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
  };

  const getAlternateErrorUrl = (language: ErrorLanguage) => {
    const url = new URL(window.location.href);

    if (/^\/(en|es)(?=\/|$)/.test(url.pathname)) {
      url.pathname = url.pathname.replace(/^\/(en|es)(?=\/|$)/, `/${language}`);
      url.searchParams.delete('lang');
    } else if (url.pathname === '/404' || url.pathname === '/500') {
      url.searchParams.set('lang', language);
    } else {
      url.pathname = `/${language}${url.pathname.startsWith('/') ? url.pathname : `/${url.pathname}`}`;
      url.searchParams.delete('lang');
    }

    return `${url.pathname}${url.search}${url.hash}`;
  };

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const applyErrorLanguage = (language: ErrorLanguage) => {
    const page = document.querySelector<HTMLElement>('[data-error-translations]');
    const code = page?.dataset.errorCode as ErrorCode | undefined;
    if (!page || !code) return;

    const translations = JSON.parse(page.dataset.errorTranslations ?? '{}') as Record<
      ErrorLanguage,
      ErrorTranslation
    >;
    const locale = translations[language];
    const error = locale?.ui.error.errors[code];
    if (!locale || !error) return;

    document.documentElement.lang = language;
    document.title = `${code} — ${error.title} — David Barbosa`;
    document.querySelector<HTMLMetaElement>('meta[name="description"]')?.setAttribute('content', error.description);

    setText('[data-error-title]', error.title);
    setText('[data-error-message]', error.description);
    setText('[data-error-primary]', error.primary);
    setText('[data-error-developer]', locale.modes.developer);
    setText('[data-error-photography]', locale.modes.photographer);
    setText('.skip-link', locale.ui.common.skipToContent);
    setText('.back-to-top span', locale.ui.common.top);

    document.querySelector('[data-error-actions]')?.setAttribute('aria-label', locale.ui.error.actionsLabel);
    document.querySelector('.site-tools')?.setAttribute('aria-label', locale.ui.common.utilityNavigation);

    const homeLink = document.querySelector<HTMLAnchorElement>('.wordmark');
    if (homeLink) {
      homeLink.href = `/${language}/dev/`;
      homeLink.setAttribute('aria-label', locale.ui.common.homeLabel);
    }

    const primaryLink = document.querySelector<HTMLAnchorElement>('a[data-error-primary]');
    if (primaryLink) primaryLink.href = `/${language}/dev/`;

    const developerLink = document.querySelector<HTMLAnchorElement>('[data-error-developer]');
    if (developerLink) developerLink.href = `/${language}/dev/`;

    const photographyLink = document.querySelector<HTMLAnchorElement>('[data-error-photography]');
    if (photographyLink) photographyLink.href = `/${language}/ph/`;

    const languageLink = document.querySelector<HTMLAnchorElement>('.language-link');
    if (languageLink) {
      const nextLanguage = language === 'en' ? 'es' : 'en';
      languageLink.href = getAlternateErrorUrl(nextLanguage);
      languageLink.hreflang = nextLanguage;
      languageLink.lang = nextLanguage;
      languageLink.textContent = nextLanguage.toUpperCase();
      languageLink.setAttribute('aria-label', locale.ui.common.switchLanguage);
      languageLink.title = locale.ui.common.switchLanguage;
      languageLink.removeAttribute('data-language-link');
    }

    const themeButton = document.querySelector<HTMLElement>('[data-theme-toggle]');
    if (themeButton) {
      themeButton.dataset.themeLightLabel = locale.theme.light;
      themeButton.dataset.themeDarkLabel = locale.theme.dark;
      const themeLabel = document.documentElement.dataset.theme === 'dark'
        ? locale.theme.light
        : locale.theme.dark;
      themeButton.setAttribute('aria-label', themeLabel);
      themeButton.title = themeLabel;
    }

    const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
    if (backToTop) {
      backToTop.setAttribute('aria-label', locale.ui.common.backToTop);
      backToTop.title = locale.ui.common.backToTop;
    }
  };

  const localizeErrorPage = () => applyErrorLanguage(getErrorLanguage());

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (event.target.closest('[data-error-retry]')) {
      window.location.reload();
      return;
    }

    const languageLink = event.target.closest<HTMLAnchorElement>('.language-link');
    if (!languageLink || !document.querySelector('.error-page')) return;

    event.preventDefault();
    const nextLanguage = document.documentElement.lang === 'es' ? 'en' : 'es';
    window.history.replaceState({}, '', languageLink.href);
    applyErrorLanguage(nextLanguage);
  });

  localizeErrorPage();
  localizeErrorPage();
</script>
