---
import { Image } from 'astro:assets';
import background from '../assets/bg_dark.jpg';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { copy } from '../i18n/content';
import SiteLayout from '../layouts/SiteLayout.astro';

interface Props {
  code: '404' | '500';
}

const { code } = Astro.props;
const isNotFound = code === '404';
const translations = {
  en: {
    '404': {
      title: 'This page took a wrong turn.',
      description:
        'The address may have changed, or the page may no longer be here. Choose a place to continue.',
      primary: 'Back home',
    },
    '500': {
      title: 'Something got tangled.',
      description:
        'This page could not load right now. Try again, or choose another place to continue.',
      primary: 'Try again',
    },
    actionsLabel: 'Choose where to continue',
    developer: copy.en.modes.developer,
    photography: copy.en.modes.photographer,
    footer: copy.en.footer.statement,
    skip: 'Skip to content',
    utilityNav: 'Utility navigation',
    homeLabel: 'David Barbosa — home',
    switchLanguage: 'Cambiar a español',
    backToTop: 'Back to top',
    top: 'Top',
    themeLight: copy.en.theme.light,
    themeDark: copy.en.theme.dark,
  },
  es: {
    '404': {
      title: 'Esta página tomó un desvío.',
      description:
        'La dirección puede haber cambiado o la página ya no está aquí. Elige dónde continuar.',
      primary: 'Volver al inicio',
    },
    '500': {
      title: 'Algo se enredó.',
      description:
        'Esta página no pudo cargar ahora. Inténtalo de nuevo o elige otro lugar para continuar.',
      primary: 'Intentar de nuevo',
    },
    actionsLabel: 'Elige dónde continuar',
    developer: copy.es.modes.developer,
    photography: copy.es.modes.photographer,
    footer: copy.es.footer.statement,
    skip: 'Saltar al contenido',
    utilityNav: 'Navegación de utilidades',
    homeLabel: 'David Barbosa — inicio',
    switchLanguage: 'Switch to English',
    backToTop: 'Volver arriba',
    top: 'Inicio',
    themeLight: copy.es.theme.light,
    themeDark: copy.es.theme.dark,
  },
} as const;
const initial = translations.en[code];
const pageTitle = `${code} — ${initial.title} — David Barbosa`;
---

<SiteLayout lang="en" title={pageTitle} description={initial.description}>
  <SiteHeader lang="en" />

  <main
    id="main"
    class="error-page"
    data-error-code={code}
    data-error-translations={JSON.stringify(translations)}
  >
    <Image
      class="error-page__background"
      src={background}
      alt=""
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
    <div class="error-page__shade" aria-hidden="true"></div>

    <section class="error-page__content" aria-labelledby="error-title">
      <p class="error-page__code">Error / {code}</p>
      <h1 id="error-title" data-error-title>{initial.title}</h1>
      <p class="error-page__message" data-error-message>{initial.description}</p>

      <nav class="error-page__actions" aria-label={translations.en.actionsLabel} data-error-actions>
        {isNotFound ? (
          <a class="button" href="/en/dev/" data-error-primary>{initial.primary}</a>
        ) : (
          <button class="button" type="button" data-error-primary data-error-retry>{initial.primary}</button>
        )}
        {!isNotFound && <a class="text-link" href="/en/dev/" data-error-developer>{translations.en.developer}</a>}
        <a class="text-link" href="/en/ph/" data-error-photography>{translations.en.photography}</a>
      </nav>
    </section>
  </main>

  <SiteFooter lang="en" />
</SiteLayout>

<script>
  type ErrorLanguage = 'en' | 'es';
  type ErrorCode = '404' | '500';

  interface ErrorTranslation {
    '404': { title: string; description: string; primary: string };
    '500': { title: string; description: string; primary: string };
    actionsLabel: string;
    developer: string;
    photography: string;
    footer: string;
    skip: string;
    utilityNav: string;
    homeLabel: string;
    switchLanguage: string;
    backToTop: string;
    top: string;
    themeLight: string;
    themeDark: string;
  }

  const isErrorLanguage = (value: string | null): value is ErrorLanguage =>
    value === 'en' || value === 'es';

  const getErrorLanguage = (): ErrorLanguage => {
    const url = new URL(window.location.href);
    const queryLanguage = url.searchParams.get('lang');
    if (isErrorLanguage(queryLanguage)) return queryLanguage;

    const pathLanguage = url.pathname.split('/').filter(Boolean)[0] ?? null;
    if (isErrorLanguage(pathLanguage)) return pathLanguage;

    return window.navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
  };

  const getAlternateErrorUrl = (language: ErrorLanguage) => {
    const url = new URL(window.location.href);

    if (/^\/(en|es)(?=\/|$)/.test(url.pathname)) {
      url.pathname = url.pathname.replace(/^\/(en|es)(?=\/|$)/, `/${language}`);
      url.searchParams.delete('lang');
    } else if (url.pathname === '/404' || url.pathname === '/500') {
      url.searchParams.set('lang', language);
    } else {
      url.pathname = `/${language}${url.pathname.startsWith('/') ? url.pathname : `/${url.pathname}`}`;
      url.searchParams.delete('lang');
    }

    return `${url.pathname}${url.search}${url.hash}`;
  };

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const applyErrorLanguage = (language: ErrorLanguage) => {
    const page = document.querySelector<HTMLElement>('[data-error-translations]');
    const code = page?.dataset.errorCode as ErrorCode | undefined;
    if (!page || !code) return;

    const translations = JSON.parse(page.dataset.errorTranslations ?? '{}') as Record<
      ErrorLanguage,
      ErrorTranslation
    >;
    const locale = translations[language];
    const error = locale?.[code];
    if (!locale || !error) return;

    document.documentElement.lang = language;
    document.title = `${code} — ${error.title} — David Barbosa`;
    document.querySelector<HTMLMetaElement>('meta[name="description"]')?.setAttribute('content', error.description);

    setText('[data-error-title]', error.title);
    setText('[data-error-message]', error.description);
    setText('[data-error-primary]', error.primary);
    setText('[data-error-developer]', locale.developer);
    setText('[data-error-photography]', locale.photography);
    setText('.skip-link', locale.skip);
    setText('.site-footer__statement', locale.footer);
    setText('.back-to-top span', locale.top);

    document.querySelector('[data-error-actions]')?.setAttribute('aria-label', locale.actionsLabel);
    document.querySelector('.site-tools')?.setAttribute('aria-label', locale.utilityNav);

    const homeLink = document.querySelector<HTMLAnchorElement>('.wordmark');
    if (homeLink) {
      homeLink.href = `/${language}/dev/`;
      homeLink.setAttribute('aria-label', locale.homeLabel);
    }

    const primaryLink = document.querySelector<HTMLAnchorElement>('a[data-error-primary]');
    if (primaryLink) primaryLink.href = `/${language}/dev/`;

    const developerLink = document.querySelector<HTMLAnchorElement>('[data-error-developer]');
    if (developerLink) developerLink.href = `/${language}/dev/`;

    const photographyLink = document.querySelector<HTMLAnchorElement>('[data-error-photography]');
    if (photographyLink) photographyLink.href = `/${language}/ph/`;

    const languageLink = document.querySelector<HTMLAnchorElement>('.language-link');
    if (languageLink) {
      const nextLanguage = language === 'en' ? 'es' : 'en';
      languageLink.href = getAlternateErrorUrl(nextLanguage);
      languageLink.hreflang = nextLanguage;
      languageLink.lang = language;
      languageLink.textContent = language.toUpperCase();
      languageLink.setAttribute('aria-label', locale.switchLanguage);
      languageLink.title = locale.switchLanguage;
      languageLink.removeAttribute('data-language-link');
    }

    const themeButton = document.querySelector<HTMLElement>('[data-theme-toggle]');
    if (themeButton) {
      const themeLabel = document.documentElement.dataset.theme === 'dark'
        ? locale.themeLight
        : locale.themeDark;
      themeButton.setAttribute('aria-label', themeLabel);
      themeButton.title = themeLabel;
    }

    const backToTop = document.querySelector<HTMLElement>('[data-back-to-top]');
    if (backToTop) {
      backToTop.setAttribute('aria-label', locale.backToTop);
      backToTop.title = locale.backToTop;
    }
  };

  const localizeErrorPage = () => applyErrorLanguage(getErrorLanguage());

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (event.target.closest('[data-error-retry]')) {
      window.location.reload();
      return;
    }

    const languageLink = event.target.closest<HTMLAnchorElement>('.language-link');
    if (!languageLink || !document.querySelector('.error-page')) return;

    event.preventDefault();
    const nextLanguage = document.documentElement.lang === 'es' ? 'en' : 'es';
    window.history.replaceState({}, '', languageLink.href);
    applyErrorLanguage(nextLanguage);
  });

  document.addEventListener('astro:page-load', localizeErrorPage);
  localizeErrorPage();
</script>
