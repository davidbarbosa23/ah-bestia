---
import arrowDown from '@tabler/icons/outline/arrow-down.svg?raw';
import arrowLeft from '@tabler/icons/outline/arrow-left.svg?raw';
import arrowRight from '@tabler/icons/outline/arrow-right.svg?raw';
import arrowUp from '@tabler/icons/outline/arrow-up.svg?raw';
import arrowUpRight from '@tabler/icons/outline/arrow-up-right.svg?raw';
import chevronLeft from '@tabler/icons/outline/chevron-left.svg?raw';
import chevronRight from '@tabler/icons/outline/chevron-right.svg?raw';
import enter from '@tabler/icons/outline/corner-down-left.svg?raw';
import folder from '@tabler/icons/outline/folder.svg?raw';
import fullscreen from '@tabler/icons/outline/arrows-maximize.svg?raw';
import fullscreenExit from '@tabler/icons/outline/arrows-minimize.svg?raw';
import minus from '@tabler/icons/outline/minus.svg?raw';
import plus from '@tabler/icons/outline/plus.svg?raw';
import status from '@tabler/icons/outline/circle-dot.svg?raw';
import x from '@tabler/icons/outline/x.svg?raw';
import search from '@tabler/icons/outline/search.svg?raw';
import sun from '@tabler/icons/outline/sun.svg?raw';
import moon from '@tabler/icons/outline/moon.svg?raw';

const icons = { 'arrow-down': arrowDown, 'arrow-left': arrowLeft, 'arrow-right': arrowRight, 'arrow-up': arrowUp, 'arrow-up-right': arrowUpRight, 'chevron-left': chevronLeft, 'chevron-right': chevronRight, enter, folder, fullscreen, 'fullscreen-exit': fullscreenExit, minus, plus, status, x, search, sun, moon };
interface Props { name: keyof typeof icons; class?: string; }
const { name, class: className } = Astro.props;
// Official SVG assets render on the server: no icon runtime or React bundle.
const content = icons[name].replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" style="stroke-width: var(--icon-stroke)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={content} />
