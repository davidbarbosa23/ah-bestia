---
import type { ArchivePhoto } from '../data/photoArchive';
import { photoGridSizes } from '../data/photoArchive';
import { ui, type Lang } from '../i18n/content';
import Icon from './Icon.astro';
import { formatPhotoFolder } from '../utils/photoFolder';

interface Props { photo: ArchivePhoto; lang: Lang; priority?: boolean; }
const { photo, lang, priority = false } = Astro.props;
const folderName = formatPhotoFolder(photo.folder);
---

<figure class="photo-grid__card" data-grid-card data-photo-id={photo.id}>
  <div class="photo-grid__media">
    <a
      class="photo-grid__open"
      href={photo.viewer}
      aria-label={`${ui[lang].photography.series.openFullscreen}: ${photo.alt}`}
      aria-haspopup="dialog"
      aria-controls="photo-lightbox"
      data-lightbox-open
      data-lightbox-src={photo.viewer}
      data-lightbox-alt={photo.alt}
      data-lightbox-filename={photo.filename}
    >
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={photoGridSizes}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="photo-grid__action photo-grid__view"><Icon name="fullscreen" /><span>{ui[lang].photography.grid.viewPhoto}</span></span>
    </a>
    <button
      type="button"
      class="photo-grid__action photo-grid__folder"
      data-grid-folder={photo.folder}
      aria-label={`${ui[lang].photography.grid.filterFolder}: ${folderName}`}
      aria-controls="photo-grid-items"
      title={`${ui[lang].photography.grid.filterFolder}: ${folderName}`}
    ><Icon name="folder" /><span>{folderName}</span></button>
  </div>
  <figcaption><span>{photo.title}</span><span>{photo.tagLabel}</span></figcaption>
</figure>
