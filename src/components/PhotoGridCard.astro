---
import type { ArchivePhoto } from '../data/photoArchive';
import { photoGridSizes } from '../data/photoArchive';
import { ui, type Lang } from '../i18n/content';

interface Props { photo: ArchivePhoto; lang: Lang; priority?: boolean; }
const { photo, lang, priority = false } = Astro.props;
---

<figure class="photo-grid__card" data-grid-card data-photo-id={photo.id}>
  <a
    class="photo-grid__open"
    href={photo.viewer}
    aria-label={`${ui[lang].photography.series.openFullscreen}: ${photo.alt}`}
    aria-haspopup="dialog"
    aria-controls="photo-lightbox"
    data-lightbox-open
    data-lightbox-src={photo.viewer}
    data-lightbox-alt={photo.alt}
    data-lightbox-filename={photo.filename}
  >
    <img
      src={photo.src}
      srcset={photo.srcset}
      sizes={photoGridSizes}
      width={photo.width}
      height={photo.height}
      alt={photo.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </a>
  <figcaption><span>{photo.title}</span><span>{photo.tagLabel}</span></figcaption>
</figure>
