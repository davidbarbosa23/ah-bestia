---
import '../styles/photo-lightbox.css';
import { ui, type Lang } from '../i18n/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = ui[lang].photography.lightbox;
---

<dialog class="photo-lightbox" id="photo-lightbox" data-photo-lightbox aria-label={labels.viewer}>
  <div class="photo-lightbox__stage" data-lightbox-stage>
    <div class="photo-lightbox__slide" data-lightbox-slide>
      <img data-lightbox-image alt="" draggable="false" />
    </div>
    <div class="photo-lightbox__slide photo-lightbox__carousel-slide" data-lightbox-carousel-slide aria-hidden="true">
      <img data-lightbox-carousel-image alt="" draggable="false" />
    </div>
  </div>

  <div class="photo-lightbox__toolbar">
    <div class="photo-lightbox__identity" aria-live="polite">
      <span data-lightbox-count></span>
      <span data-lightbox-filename></span>
    </div>

    <div class="photo-lightbox__controls">
      <button type="button" data-lightbox-zoom-out aria-label={labels.zoomOut} title={labels.zoomOut}><Icon name="minus" /></button>
      <button class="photo-lightbox__zoom" type="button" data-lightbox-reset aria-label={labels.reset} title={labels.reset}>100%</button>
      <button type="button" data-lightbox-zoom-in aria-label={labels.zoomIn} title={labels.zoomIn}><Icon name="plus" /></button>
      <button type="button" data-lightbox-close aria-label={labels.close} title={labels.close}><Icon name="x" /></button>
    </div>
  </div>

  <button class="photo-lightbox__nav photo-lightbox__nav--previous" type="button" data-lightbox-previous aria-label={labels.previous}><Icon name="chevron-left" /></button>
  <button class="photo-lightbox__nav photo-lightbox__nav--next" type="button" data-lightbox-next aria-label={labels.next}><Icon name="chevron-right" /></button>
  <p class="photo-lightbox__hint">{labels.hint}</p>
</dialog>

<script>
  import '../scripts/photoLightbox';
</script>
