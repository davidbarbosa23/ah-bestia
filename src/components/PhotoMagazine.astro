---
import { getImage } from 'astro:assets';
import { ui, type Lang } from '../i18n/content';
import type { PhotoGallery } from '../types/photos';
import Icon from './Icon.astro';

interface Props {
  gallery: PhotoGallery;
  lang: Lang;
}

const { gallery, lang } = Astro.props;
const magazine = gallery.magazine;

if (!magazine) {
  throw new Error(`PhotoMagazine requires a magazine configuration for ${gallery.slug}`);
}

const content = gallery.content[lang];
const labels = ui[lang].photography;
const { width: pageWidth, height: pageHeight } = magazine.pageSize;
const spreadMaxByHeight = `${Math.round(70 * pageWidth * 2 / pageHeight * 1000) / 1000}svh`;
const fullscreenSpreadMaxByHeight = `${Math.round(88 * pageWidth * 2 / pageHeight * 1000) / 1000}dvh`;

const pages = await Promise.all(
  magazine.pages.map(async (page, index) => {
    const [small, large] = await Promise.all([
      getImage({
        src: page.imageAsset,
        width: Math.min(720, page.imageAsset.width),
        format: 'webp',
        quality: 78,
      }),
      getImage({
        src: page.imageAsset,
        width: Math.min(1200, page.imageAsset.width),
        format: 'webp',
        quality: 82,
      }),
    ]);

    return {
      ...page,
      alt: page.alt?.[lang]
        ?? `${labels.series.photo} ${index + 1} ${labels.series.from} ${content.title}`,
      small,
      large,
      // Fullscreen and zoom use the original without resizing or recompression.
      expanded: page.imageAsset,
    };
  }),
);
---

<section
  class="magazine"
  data-magazine
  data-page-label={labels.magazine.page}
  data-pages-label={labels.magazine.pages}
  data-of-label={labels.magazine.of}
  data-fullscreen-label={labels.magazine.fullscreen}
  data-exit-fullscreen-label={labels.magazine.exitFullscreen}
  aria-label={`${labels.magazine.reader}: ${content.title}`}
  tabindex="0"
  style={`--magazine-spread-ratio: ${pageWidth * 2} / ${pageHeight}; --magazine-spread-max-by-height: ${spreadMaxByHeight}; --magazine-fullscreen-spread-max-by-height: ${fullscreenSpreadMaxByHeight}; --magazine-count-width: ${String(pages.length).length * 3 + 4}ch;`}
>
  <h2 class="sr-only">{labels.magazine.reader}: {content.title}</h2>


  <div class="magazine__viewport">
    <div class="magazine__book" data-magazine-book>
      <ol class="magazine__pages">
        {pages.map((page, index) => (
          <li
            class="magazine__page"
            data-magazine-page
            data-page-index={index}
            data-photo-id={page.image}
            data-fit={page.fit}
            data-tone={page.tone}
            data-position={index === 0 ? 'single' : undefined}
            aria-hidden={index === 0 ? 'false' : 'true'}
            style={`--magazine-photo-position: ${page.position};`}
          >
            <div class="magazine__photo">
              <img
                src={index === 0 ? page.large.src : undefined}
                srcset={index === 0 ? `${page.small.src} ${page.small.attributes.width}w, ${page.large.src} ${page.large.attributes.width}w` : undefined}
                sizes="(min-width: 48rem) 36rem, 92vw"
                width={page.imageAsset.width}
                height={page.imageAsset.height}
                alt={page.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
                draggable="false"
                transition:name={index === 0 ? `gallery-cover-${gallery.slug}` : undefined}
                data-magazine-image
                data-src={page.large.src}
                data-srcset={`${page.small.src} ${page.small.attributes.width}w, ${page.large.src} ${page.large.attributes.width}w`}
                data-expanded-src={page.expanded.src}
              />
            </div>
          </li>
        ))}
      </ol>
      <div class="magazine__turn-layer" data-magazine-turn-layer aria-hidden="true" hidden>
        <div class="magazine__turn-bottom" data-magazine-turn-bottom></div>
        <div
          class="magazine__turn-shadow magazine__turn-shadow--outer"
          data-magazine-turn-shadow
        ></div>
        <div class="magazine__turn-page" data-magazine-turn-page>
          <div
            class="magazine__turn-face"
            data-magazine-turn-front
          ></div>
        </div>
        <div
          class="magazine__turn-shadow magazine__turn-shadow--inner"
          data-magazine-turn-inner-shadow
        ></div>
      </div>
    </div>

    <button
      class="magazine__turn magazine__turn--previous"
      type="button"
      data-magazine-previous
      aria-label={labels.magazine.previous}
      disabled
    >
      <Icon name="chevron-left" />
    </button>
    <button
      class="magazine__turn magazine__turn--next"
      type="button"
      data-magazine-next
      aria-label={labels.magazine.next}
    >
      <Icon name="chevron-right" />
    </button>
  </div>

  <div class="magazine__toolbar">
    <div class="magazine__navigation">
      <div class="magazine__count">
        <output class="sr-only" data-magazine-count aria-live="polite">
          {labels.magazine.page} 1 {labels.magazine.of} {pages.length}
        </output>
        <span data-magazine-compact-count aria-hidden="true">1 / {pages.length}</span>
      </div>
      <input
        class="magazine__progress"
        data-magazine-progress
        type="range"
        min="1"
        step="1"
        value="1"
        max={pages.length}
        aria-label={labels.magazine.goToPage}
        aria-valuetext={`${labels.magazine.page} 1 ${labels.magazine.of} ${pages.length}`}
        disabled
      />
    </div>
    <div
      class="magazine__zoom-controls"
      data-magazine-zoom-controls
      role="group"
      aria-label={labels.magazine.zoomControls}
      hidden
    >
      <button
        type="button"
        data-magazine-zoom-out
        aria-label={labels.lightbox.zoomOut}
        title={labels.lightbox.zoomOut}
        disabled
      ><Icon name="minus" /></button>
      <button
        class="magazine__zoom-value"
        type="button"
        data-magazine-zoom-reset
        aria-label={labels.lightbox.reset}
        title={labels.lightbox.reset}
      >100%</button>
      <button
        type="button"
        data-magazine-zoom-in
        aria-label={labels.lightbox.zoomIn}
        title={labels.lightbox.zoomIn}
      ><Icon name="plus" /></button>
    </div>
    <button
      class="magazine__fullscreen"
      type="button"
      data-magazine-fullscreen
      aria-label={labels.magazine.fullscreen}
      title={labels.magazine.fullscreen}
      hidden
    >
      <span data-magazine-fullscreen-text>{labels.magazine.fullscreen}</span>
      <span class="magazine__fullscreen-icon--enter"><Icon name="fullscreen" /></span>
      <span class="magazine__fullscreen-icon--exit"><Icon name="fullscreen-exit" /></span>
    </button>
  </div>

  <p class="magazine__hint">
    <span class="magazine__hint-full">{labels.magazine.hint}</span>
    <span class="magazine__hint-compact">{labels.magazine.compactHint}</span>
  </p>
</section>

<script>
  import '../scripts/photoMagazine';
</script>

<style>
  .magazine {
    width: 100%;
    border: var(--rule-hair) solid var(--color-rule-2);
    background: var(--color-magazine-canvas);
    color: var(--color-magazine-ink);
    outline: none;
  }

  .magazine::backdrop {
    background: var(--color-magazine-canvas);
  }

  .magazine:focus-visible {
    outline: var(--outline-focus) solid var(--color-focus);
    outline-offset: var(--outline-offset-focus);
  }

  .magazine__viewport {
    position: relative;
    padding: var(--space-sm) calc(var(--size-control) + var(--space-xs));
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .magazine__book {
    position: relative;
    width: min(100%, 72rem, var(--magazine-spread-max-by-height));
    aspect-ratio: var(--magazine-spread-ratio);
    touch-action: pan-y;
    /* The curl uses 2D geometry; keep every sheet in one ordered paint stack. */
    isolation: isolate;
  }

  .magazine__pages {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .magazine__turn-layer {
    position: absolute;
    inset: 0;
    z-index: calc(var(--layer-overlay) + 1);
    pointer-events: none;
  }

  .magazine__turn-layer[hidden] {
    display: none;
  }

  .magazine__turn-page,
  .magazine__turn-bottom {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 50%;
    height: 100%;
    background: var(--color-magazine-page);
    overflow: hidden;
  }

  .magazine__turn-bottom {
    z-index: var(--layer-content);
  }

  .magazine__turn-layer[data-direction='next'] .magazine__turn-bottom {
    /* Use the same layout position as the static right page. A fractional
       transform can resample the photograph when the turn takes over. */
    inset-inline-start: 50%;
  }

  .magazine__turn-page {
    z-index: var(--layer-overlay);
    transform-origin: 0 0;
  }

  .magazine__turn-face {
    position: absolute;
    inset: 0;
    background: var(--color-magazine-page);
    overflow: hidden;
  }

  .magazine__turn-face[data-tone='paper'] {
    background: var(--color-paper-2);
  }

  .magazine__turn-bottom[data-tone='paper'] {
    background: var(--color-paper-2);
  }

  .magazine__turn-bottom[data-empty='true'] {
    background: var(--color-magazine-canvas);
  }

  .magazine__turn-bottom .magazine__photo,
  .magazine__turn-bottom .magazine__photo img,
  .magazine__turn-face .magazine__photo,
  .magazine__turn-face .magazine__photo img {
    width: 100%;
    height: 100%;
  }

  .magazine__turn-bottom .magazine__photo img,
  .magazine__turn-face .magazine__photo img {
    display: block;
    object-fit: cover;
    object-position: var(--magazine-photo-position);
    user-select: none;
  }

  .magazine__turn-bottom[data-fit='contain'] .magazine__photo img,
  .magazine__turn-face[data-fit='contain'] .magazine__photo img {
    object-fit: contain;
  }

  .magazine__turn-shadow {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: var(--layer-tooltip);
    pointer-events: none;
  }

  .magazine__page {
    position: absolute;
    inset-block: 0;
    width: 50%;
    background: var(--color-magazine-page);
    box-shadow: var(--shadow-magazine-page-surface);
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }

  .magazine__page[data-tone='paper'] {
    background: var(--color-paper-2);
  }

  .magazine__page[data-position] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .magazine__page[data-position='left'] {
    inset-inline-start: 0;
    box-shadow: var(--shadow-magazine-left-page-surface);
    transform-origin: right center;
  }

  .magazine__page[data-position='right'] {
    inset-inline-start: 50%;
    box-shadow: var(--shadow-magazine-right-page-surface);
    transform-origin: left center;
  }

  :is(.magazine__page, .magazine__turn-bottom, .magazine__turn-face)[data-position='left']::after,
  :is(.magazine__page, .magazine__turn-bottom, .magazine__turn-face)[data-position='right']::after {
    position: absolute;
    inset-block: 0;
    z-index: var(--layer-content);
    width: clamp(var(--space-sm), 7%, var(--space-xl));
    content: '';
    pointer-events: none;
  }

  :is(.magazine__page, .magazine__turn-bottom, .magazine__turn-face)[data-position='left']::after {
    inset-inline-end: 0;
    background: linear-gradient(
      to left,
      color-mix(in oklch, var(--color-magazine-ink) 24%, transparent),
      color-mix(in oklch, var(--color-magazine-ink) 9%, transparent) 38%,
      transparent
    );
    opacity: 0.3;
  }

  :is(.magazine__page, .magazine__turn-bottom, .magazine__turn-face)[data-position='right']::after {
    inset-inline-start: 0;
    background: linear-gradient(
      to right,
      color-mix(in oklch, var(--color-magazine-ink) 24%, transparent),
      color-mix(in oklch, var(--color-magazine-ink) 9%, transparent) 38%,
      transparent
    );
    opacity: 0.3;
  }

  .magazine__page[data-position='single'] {
    inset-inline-start: 25%;
    box-shadow: var(--shadow-magazine-page-surface);
  }

  .magazine__photo {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    background: transparent;
    color: inherit;
  }

  .magazine__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: var(--magazine-photo-position);
    user-select: none;
  }

  .magazine__page[data-fit='contain'] .magazine__photo img {
    object-fit: contain;
  }

  .magazine.is-turning .magazine__book {
    pointer-events: none;
  }

  .magazine__turn {
    position: absolute;
    inset-block-start: 50%;
    z-index: var(--layer-overlay);
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    border: var(--rule-hair) solid var(--color-magazine-rule);
    border-radius: var(--radius-control);
    display: grid;
    place-items: center;
    background: var(--color-magazine-surface);
    color: var(--color-magazine-ink-muted);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background var(--dur-micro) var(--ease-out),
      opacity var(--dur-micro) var(--ease-out);
  }

  .magazine__turn--previous {
    inset-inline-start: var(--space-sm);
  }

  .magazine__turn--next {
    inset-inline-end: var(--space-sm);
  }

  .magazine__turn:disabled {
    opacity: var(--opacity-disabled);
    cursor: not-allowed;
  }

  .magazine__turn:active {
    transform: translateY(-50%);
  }

  .magazine__turn:focus-visible,
  .magazine__fullscreen:focus-visible,
  .magazine__zoom-controls button:focus-visible {
    outline: var(--outline-control) solid var(--color-focus);
    outline-offset: var(--outline-offset-control);
  }

  .magazine__toolbar {
    padding: var(--space-2xs) var(--space-sm);
    border-block-start: var(--rule-hair) solid var(--color-magazine-divider);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-magazine-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .magazine__navigation {
    min-width: 0;
    display: grid;
    /* Reserve the longest page count so scrubbing never moves the range track. */
    grid-template-columns: var(--magazine-count-width) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-sm);
  }

  .magazine__count {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-caption);
  }

  .magazine__progress {
    width: 100%;
    min-width: 0;
    height: var(--size-control);
    margin: 0;
    padding: 0;
    border: 0;
    appearance: none;
    background:
      linear-gradient(var(--color-accent), var(--color-accent)) left center / 0% var(--space-3xs) no-repeat,
      linear-gradient(var(--color-magazine-rule), var(--color-magazine-rule)) left center / 100% var(--space-3xs) no-repeat;
    transition: background-size var(--dur-short) var(--ease-out);
    cursor: pointer;
    touch-action: pan-y;
  }

  .magazine__progress:focus-visible {
    outline: var(--outline-control) solid var(--color-accent);
    outline-offset: var(--outline-offset-control);
  }

  .magazine__progress::-webkit-slider-runnable-track {
    height: var(--space-3xs);
    background: transparent;
  }

  .magazine__progress::-webkit-slider-thumb {
    width: var(--space-md);
    height: var(--space-md);
    margin-top: calc((var(--space-3xs) - var(--space-md)) / 2);
    border: var(--rule-hair) solid var(--color-magazine-surface);
    border-radius: var(--radius-round);
    appearance: none;
    background: var(--color-accent);
  }

  .magazine__progress::-moz-range-track {
    height: var(--space-3xs);
    background: transparent;
  }

  .magazine__progress::-moz-range-thumb {
    width: var(--space-md);
    height: var(--space-md);
    border: var(--rule-hair) solid var(--color-magazine-surface);
    border-radius: var(--radius-round);
    background: var(--color-accent);
  }

  .magazine__zoom-controls {
    border: var(--rule-hair) solid var(--color-magazine-rule);
    display: inline-grid;
    grid-template-columns: var(--size-control) 3.75rem var(--size-control);
    gap: var(--space-2xs);
    justify-self: end;
  }

  .magazine__zoom-controls[hidden] {
    display: none;
  }

  .magazine__zoom-controls button {
    min-width: var(--size-control);
    min-height: var(--size-control);
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    display: grid;
    place-items: center;
    background: transparent;
    color: var(--color-magazine-ink-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .magazine__zoom-controls button:disabled {
    opacity: var(--opacity-disabled);
    cursor: not-allowed;
  }

  .magazine__fullscreen {
    min-width: var(--size-control);
    min-height: var(--size-control);
    padding: 0;
    border: var(--rule-hair) solid var(--color-magazine-rule);
    border-radius: var(--radius-control);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    gap: var(--space-xs);
    background: transparent;
    color: var(--color-magazine-ink-muted);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .magazine__fullscreen[hidden] {
    display: none;
  }

  .magazine__fullscreen [data-magazine-fullscreen-text] {
    display: none;
  }

  .magazine__fullscreen-icon--exit {
    display: none;
  }

  .magazine.is-fullscreen .magazine__fullscreen-icon--enter {
    display: none;
  }

  .magazine.is-fullscreen .magazine__fullscreen-icon--exit {
    display: inline;
  }

  .magazine__hint {
    margin: 0;
    padding: 0 var(--space-sm) var(--space-xs);
    color: var(--color-magazine-ink-subtle);
    font-family: var(--font-mono);
    font-size: calc(var(--text-xs) * 0.875);
    line-height: var(--leading-caption);
    text-align: center;
  }

  .magazine__hint-full {
    display: none;
  }

  :global(body.magazine-expanded) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .magazine.is-fullscreen {
    position: relative;
    padding: var(--space-xs);
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    border: 0;
    background: var(--color-magazine-canvas);
  }

  .magazine.is-expanded {
    position: fixed;
    inset: 0;
    z-index: var(--layer-skip-link);
    width: 100%;
    height: 100dvh;
    padding-block: max(var(--space-xs), env(safe-area-inset-top)) max(var(--space-xs), env(safe-area-inset-bottom));
    padding-inline: max(var(--space-xs), env(safe-area-inset-left)) max(var(--space-xs), env(safe-area-inset-right));
    overflow: hidden;
  }

  .magazine.is-fullscreen .magazine__viewport {
    min-height: 0;
    padding-block: var(--space-xs);
    touch-action: none;
  }

  .magazine.is-fullscreen .magazine__book {
    width: min(100%, var(--magazine-fullscreen-spread-max-by-height));
    touch-action: none;
  }

  .magazine.is-fullscreen .magazine__toolbar {
    position: absolute;
    inset: 0;
    z-index: var(--layer-overlay);
    display: block;
    padding: 0;
    border: 0;
    pointer-events: none;
  }

  .magazine.is-fullscreen .magazine__navigation {
    position: absolute;
    inset-block-end: max(var(--space-xs), env(safe-area-inset-bottom));
    inset-inline: max(var(--space-lg), env(safe-area-inset-left)) max(var(--space-lg), env(safe-area-inset-right));
    width: min(var(--size-magazine-navigation-compact), calc(100% - max(var(--space-lg), env(safe-area-inset-left)) - max(var(--space-lg), env(safe-area-inset-right))));
    margin-inline: auto;
    padding: 0 var(--space-xs);
    gap: var(--space-xs);
    border: var(--rule-hair) solid var(--color-magazine-rule);
    border-radius: var(--radius-sm);
    background: var(--color-magazine-surface);
    pointer-events: auto;
  }

  .magazine.is-fullscreen .magazine__zoom-controls {
    position: absolute;
    inset-block-start: max(var(--space-xs), env(safe-area-inset-top));
    inset-inline-start: max(var(--space-xs), env(safe-area-inset-left));
    background: var(--color-magazine-surface);
    pointer-events: auto;
  }

  .magazine.is-fullscreen .magazine__fullscreen {
    position: absolute;
    inset-block-start: max(var(--space-xs), env(safe-area-inset-top));
    inset-inline-end: max(var(--space-xs), env(safe-area-inset-right));
    background: var(--color-magazine-surface);
    pointer-events: auto;
  }

  .magazine.is-fullscreen :is(.magazine__navigation, .magazine__zoom-controls, .magazine__fullscreen, .magazine__turn) {
    opacity: var(--opacity-magazine-controls-idle);
    transition: opacity var(--dur-short) var(--ease-out), background var(--dur-micro) var(--ease-out);
  }

  .magazine.is-fullscreen:is(.is-controls-active, :has(:focus-visible), :has(:active)) :is(.magazine__navigation, .magazine__zoom-controls, .magazine__fullscreen, .magazine__turn) {
    opacity: 1;
  }

  .magazine.is-fullscreen .magazine__turn:disabled {
    opacity: 0.25;
  }

  .magazine.is-fullscreen .magazine__hint {
    display: none;
  }

  .magazine.is-fullscreen.is-zoomed .magazine__book {
    cursor: grab;
  }

  .magazine.is-fullscreen.is-dragging .magazine__book {
    cursor: grabbing;
    transition: none;
    will-change: transform;
  }

  @media (hover: hover) {
    .magazine.is-fullscreen:has(.magazine__navigation:hover, .magazine__zoom-controls:hover, .magazine__fullscreen:hover, .magazine__turn:hover) :is(.magazine__navigation, .magazine__zoom-controls, .magazine__fullscreen, .magazine__turn:not(:disabled)) {
      opacity: 1;
    }

    .magazine__turn:not(:disabled):hover,
    .magazine__fullscreen:hover,
    .magazine__zoom-controls button:not(:disabled):hover {
      background: var(--color-magazine-hover);
    }
  }

  @media (min-width: 48rem) {
    .magazine.is-fullscreen .magazine__navigation {
      inset-inline: max(var(--space-xs), env(safe-area-inset-left)) max(var(--space-xs), env(safe-area-inset-right));
