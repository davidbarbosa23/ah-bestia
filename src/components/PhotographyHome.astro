---
import { Image } from 'astro:assets';
import { copy, ui, type Lang } from '../i18n/content';
import { photoGalleries } from '../data/photoGalleries';
import photographerCamera from '../assets/photography/photographer-hero.jpg';
import Icon from './Icon.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang].photo;
const labels = ui[lang];

---

<div class="experience experience--photographer" data-experience-panel="photographer">
  <main id="main">
    <section class="photo-archive" aria-labelledby="gallery-title">
      <header class="photo-archive__intro page-shell">
        <h1 id="gallery-title">{t.galleryTitle}</h1>
        <p>{t.galleryHint}</p>
      </header>

      <div class="photo-series-list page-shell">
        {photoGalleries.map((gallery, index) => {
          const content = gallery.content[lang];
          const seriesNumber = String(index + 1).padStart(2, '0');
          const seriesTotal = String(photoGalleries.length).padStart(2, '0');

          return (
            <article
              class:list={['photo-series', index % 2 === 1 && 'photo-series--reverse']}
              aria-labelledby={`series-${gallery.slug}`}
            >
              <div class="photo-series__details">
                <p class="photo-series__index">{seriesNumber} / {seriesTotal}</p>
                <h2 id={`series-${gallery.slug}`}>{content.cardTitle}</h2>
                <p class="photo-series__description">{content.description}</p>
                <p class="photo-series__meta">
                  <span>{content.location}</span>
                  <span>{gallery.images.length} {labels.photography.photographs}</span>
                </p>
              </div>

              <a
                class="photo-series__spread"
                href={`/${lang}/ph/${gallery.slug}/`}
                aria-label={`${t.openNote}: ${content.cardTitle}`}
                data-series-transition
              >
                <figure class="photo-series__cover">
                  <Image
                    src={gallery.cover}
                    widths={[480, 720, 960, 1200]}
                    sizes="(min-width: 60rem) 44vw, (min-width: 40rem) 62vw, 92vw"
                    quality={82}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    alt={`${content.cardTitle}. ${content.description}`}
                    transition:name={`gallery-cover-${gallery.slug}`}
                  />
                </figure>
                <figure class="photo-series__detail" aria-hidden="true">
                  <Image
                    src={gallery.indexDetail}
                    widths={[280, 420, 560, 720]}
                    sizes="(min-width: 60rem) 22vw, (min-width: 40rem) 32vw, 58vw"
                    quality={80}
                    loading="lazy"
                    alt=""
                  />
                </figure>
                <span class="photo-series__open">
                  {t.openNote}<Icon name="arrow-up-right" />
                </span>
              </a>
            </article>
          );
        })}
      </div>
    </section>

    <section class="photo-practice page-shell" aria-labelledby="photo-practice-title">
      <figure class="photo-practice__image">
        <Image
          src={photographerCamera}
          widths={[480, 720, 1080, 1400]}
          sizes="(min-width: 60rem) 58vw, 92vw"
          quality={82}
          loading="lazy"
          alt={labels.metadata.photographerHeroAlt}
        />
        <figcaption>{t.processImageCaption}</figcaption>
      </figure>

      <div class="photo-practice__copy">
        <div class="photo-practice__intro">
          <p class="mono-label">{t.processLabel}</p>
          <h2 id="photo-practice-title">{t.processTitle}</h2>
          <p>{t.processBody}</p>
        </div>

        <div class="photo-practice__contact">
          <p class="mono-label">{t.collaborationLabel}</p>
          <p>{t.collaborationBody}</p>
          <a
            class="text-link"
            href={`mailto:davidbarbosa.dev@gmail.com?subject=${encodeURIComponent(t.collaborationSubject)}`}
          >
            {t.collaborationLink}<Icon name="arrow-up-right" />
          </a>
        </div>
      </div>
    </section>

    <p class="photo-credit page-shell">{t.creditNote}</p>
  </main>
</div>
