---
import { Image } from 'astro:assets';
import { copy, ui, type Lang } from '../i18n/content';
import { photoGalleries } from '../data/photoGalleries';
import photographerHero from '../assets/photography/photographer-hero.jpg';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang].photo;
const labels = ui[lang];
---

<div class="experience experience--photographer" data-experience-panel="photographer">
  <main id="main">
    <section class="photo-hero" aria-labelledby="photo-title">
      <Image src={photographerHero} widths={[480, 720, 1080, 1400, 1800, 2100]} sizes="100vw" quality={82} priority alt={labels.metadata.photographerHeroAlt} />
      <div class="photo-hero__shade"></div>
      <div class="photo-hero__copy page-shell">
        <p class="status-line status-line--photo"><span></span>{t.status}</p>
        <h1 id="photo-title">{t.title.split('\n').map((line) => <span>{line}{' '}</span>)}</h1>
        <p>{t.intro}</p>
      </div>
    </section>

    <section class="photo-gallery" aria-labelledby="gallery-title" data-horizontal-section>
      <div class="photo-gallery__intro page-shell">
        <h2 id="gallery-title">{t.galleryTitle}</h2>
        <div class="photo-gallery__controls">
          <p>{t.galleryHint}<span aria-hidden="true">→</span></p>
          <button class="photo-gallery__toggle" type="button" data-marquee-toggle aria-pressed="false">
            <span data-pause-label>{t.pauseGallery}</span>
            <span data-play-label hidden>{t.playGallery}</span>
          </button>
        </div>
      </div>
      <div class="photo-marquee" data-photo-marquee>
        <div class="photo-track" data-photo-track>
          <div class="photo-track__group" data-photo-group>
            {photoGalleries.map((gallery) => {
              const content = gallery.content[lang];
              return (
                <figure class="photo-frame" data-gallery-slug={gallery.slug}>
                  <a href={`/${lang}/ph/${gallery.slug}/`} aria-label={`${t.openNote}: ${content.cardTitle}`}>
                    <Image
                      src={gallery.cover}
                      widths={[360, 520, 720, 900]}
                      sizes="(min-width: 60rem) 24vw, (min-width: 40rem) 52vw, 82vw"
                      quality={80}
                      loading="lazy"
                      alt={`${content.cardTitle}. ${content.description}`}
                    />
                    <span class="photo-frame__open">{t.openNote} ↗</span>
                  </a>
                  <figcaption>
                    <span><strong>{content.cardTitle}</strong>{content.location}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <p class="photo-credit page-shell">{t.creditNote}</p>
  </main>
</div>
