---
import { getImage, Image } from 'astro:assets';
import { copy, ui, type Lang } from '../i18n/content';
import { photoGalleries } from '../data/photoGalleries';
import photographerCamera from '../assets/photography/photographer-hero.jpg';
import Icon from './Icon.astro';
import PortfolioMotion from './PortfolioMotion.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang].photo;
const labels = ui[lang];
// A smaller modern source for the LCP image; keep the original WebP fallback and artwork.
const firstCoverAvif = await Promise.all([480, 720, 960, 1200].map((width) => getImage({
  src: photoGalleries[0].cover, width, format: 'avif', quality: 60,
})));
const firstCoverSrcset = firstCoverAvif.map(({ src, attributes }) => `${src} ${attributes.width}w`).join(', ');
---
<div class="experience experience--photographer" data-experience-panel="photographer">
  <main id="main" class="photography-home">
    <section class="photography-archive page-shell" aria-labelledby="gallery-title">
      <header class="photography-intro">
        <h1 id="gallery-title" data-hero-reveal>{t.galleryTitle}</h1>
        <p data-hero-reveal>{t.galleryHint}</p>
        <a class="text-link" href={`/${lang}/ph/grid/`} data-hero-reveal>{labels.photography.grid.open}<Icon name="arrow-up-right" /></a>
      </header>
      <div class="photography-collection">
        {photoGalleries.map((gallery, index) => {
          const content = gallery.content[lang];
          return (
            <article class:list={['photography-entry', `photography-entry--${index + 1}`]} aria-labelledby={`series-${gallery.slug}`} data-reveal>
              <a class="photography-entry__image" href={`/${lang}/ph/${gallery.slug}/`} aria-label={`${t.openNote}: ${content.cardTitle}`} data-series-transition>
                <picture>
                  {index === 0 && <source type="image/avif" srcset={firstCoverSrcset} sizes="(min-width: 1024px) 60vw, 92vw" />}
                  <Image src={gallery.cover} width={Math.min(1200, gallery.cover.width)} widths={[480, 720, 960, 1200]} sizes={index === 0 || index === 4 ? '(min-width: 1024px) 60vw, 92vw' : '(min-width: 1024px) 42vw, 92vw'} quality={82} priority={index === 0} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} alt={`${content.cardTitle}. ${content.description}`} transition:name={`gallery-cover-${gallery.slug}`} />
                </picture>
              </a>
              <div class="photography-entry__caption">
                <h2 id={`series-${gallery.slug}`}><a href={`/${lang}/ph/${gallery.slug}/`} data-series-transition>{content.cardTitle}<Icon name="arrow-up-right" /></a></h2>
                <p>{content.description}</p>
                <p class="photography-entry__facts"><span>{content.location}</span><span>{gallery.images.length} {labels.photography.photographs}</span></p>
              </div>
            </article>
          );
        })}
      </div>
    </section>
    <section class="photography-practice page-shell" aria-labelledby="photo-practice-title">
      <div class="photography-practice__copy" data-reveal>
        <h2 id="photo-practice-title">{t.processTitle}</h2><p>{t.processBody}</p>
        <div class="photography-practice__contact">
          <p>{t.collaborationBody}</p>
          <a class="text-link" href={`mailto:davidbarbosa.design@gmail.com?subject=${encodeURIComponent(t.collaborationSubject)}`}>{t.collaborationLink}<Icon name="arrow-up-right" /></a>
        </div>
      </div>
      <figure class="photography-practice__image" data-reveal><Image src={photographerCamera} widths={[480, 720, 1080]} sizes="(min-width: 1024px) 36vw, 92vw" quality={80} loading="lazy" alt={labels.metadata.photographerHeroAlt} /></figure>
    </section>
  </main>
  <PortfolioMotion />
</div>
