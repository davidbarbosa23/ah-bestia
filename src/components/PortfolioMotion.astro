<!-- Native animation leaf. Layout and content render without JavaScript. -->
<script>
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  let observer: IntersectionObserver | undefined;
  let animations: Animation[] = [];
  const cleanup = () => {
    observer?.disconnect();
    observer = undefined;
    animations.forEach((animation) => animation.cancel());
    animations = [];
  };
  const setup = () => {
    cleanup();
    if (preference.matches || document.documentElement.dataset.languageTransition === 'true') return;
    const easing = getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim();
    const styles = getComputedStyle(document.documentElement);
    const duration = Number.parseFloat(styles.getPropertyValue('--dur-long'));
    const distance = styles.getPropertyValue('--space-sm').trim();
    const pending = new Map<HTMLElement, Animation>();
    const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    // Read all positions before creating animations. Already-visible content stays put.
    const belowFold = elements.filter((element) => element.getBoundingClientRect().top >= window.innerHeight);
    belowFold.forEach((element) => {
      const animation = element.animate([
        { opacity: 0, transform: `translateY(${distance})` },
        { opacity: 1, transform: 'none' },
      ], { duration, easing, fill: 'both' });
      animation.pause();
      pending.set(element, animation);
      animations.push(animation);
      animation.finished.then(() => {
        animation.cancel();
        animations = animations.filter((item) => item !== animation);
      }).catch(() => {});
    });
    observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
        observer?.unobserve(entry.target);
        pending.get(entry.target)?.play();
        pending.delete(entry.target);
      });
    }, { threshold: 0, rootMargin: '0px 0px 64px 0px' });
    belowFold.forEach((element) => observer?.observe(element));
  };
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', cleanup);
  // A preference change should never replay entrances on content being read.
  preference.addEventListener('change', cleanup);
</script>

<style is:global>
  /* Start with the first styled paint; never hide primary text or the LCP image. */
  @media (prefers-reduced-motion: no-preference) {
    body:not([data-skip-entrance]) [data-hero-reveal] {
      animation: portfolio-enter var(--dur-long) var(--ease-out) backwards;
    }

    body:not([data-skip-entrance]) [data-hero-reveal]:nth-child(2) {
      animation-delay: calc(var(--dur-micro) / 3);
    }

    body:not([data-skip-entrance]) [data-hero-reveal]:nth-child(n + 3) {
      animation-delay: calc(var(--dur-micro) / 1.5);
    }
  }

  @keyframes portfolio-enter {
    from { transform: translateY(var(--space-sm)); }
    to { transform: none; }
  }
</style>
