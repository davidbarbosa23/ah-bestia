---
import { alternatePath, copy, ui, type Lang } from '../i18n/content';
import Icon from './Icon.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  lang: Lang;
  experience?: 'developer' | 'photographer';
  languageHref?: string;
}
const { lang, experience, languageHref } = Astro.props;
const t = copy[lang];
const labels = ui[lang];
const altLang = lang === 'en' ? 'es' : 'en';
const altPath = languageHref ?? alternatePath(Astro.url.pathname, lang);
const developerPath = `/${lang}/dev/`;
const photographerPath = `/${lang}/ph/`;
const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const homePath = experience === 'photographer' ? photographerPath : developerPath;
const contactEmail = experience === 'photographer' ? 'davidbarbosa.design@gmail.com' : 'davidbarbosa.dev@gmail.com';
---

<div class="header-scroll-sentinel" aria-hidden="true" data-header-sentinel></div>
<header class="site-header site-header--floating" data-site-header>
  <div class="site-header__inner">
    <span class="header-surface header-surface--shadow" aria-hidden="true"></span>
    <span class="header-surface header-surface--glass" aria-hidden="true"></span>
    <a class="wordmark" href={homePath} aria-label={`db/ ${labels.common.homeLabel}`}>
      <span class="wordmark__mobile" aria-hidden="true"><span>db/</span> David Barbosa</span>
      <span class="wordmark__letters" aria-hidden="true">
        {Array.from('David Barbosa').map((letter, index) => (
          <span class:list={['wordmark__letter', { 'wordmark__letter--initial': index === 0 || index === 6 }]} data-wordmark-letter>{letter === ' ' ? '\u00a0' : letter}</span>
        ))}
        <span class="wordmark__suffix" data-wordmark-suffix>/</span>
      </span>
    </a>

    <div class="header-navigation" id="header-navigation">
      {experience && (
        <nav class="header-experiences" aria-label={t.modes.label}>
          <a href={developerPath} aria-current={currentPath === developerPath ? 'page' : undefined} data-active-section={experience === 'developer' ? '' : undefined}>{t.modes.developer}</a>
          <a href={photographerPath} aria-current={currentPath === photographerPath ? 'page' : undefined} data-active-section={experience === 'photographer' ? '' : undefined}>{t.modes.photographer}</a>
        </nav>
      )}
      <nav class="header-tools" aria-label={labels.common.utilityNavigation}>
        <button class="theme-button" type="button" data-theme-toggle data-theme-light-label={t.theme.light} data-theme-dark-label={t.theme.dark} aria-label={t.theme.light} title={t.theme.light}>
          <Icon name="sun" class="theme-icon theme-icon--sun" />
          <Icon name="moon" class="theme-icon theme-icon--moon" />
        </button>
        <a class="language-link" href={altPath} hreflang={altLang} lang={altLang} aria-label={labels.common.switchLanguage} title={labels.common.switchLanguage} data-language-link>{altLang.toUpperCase()}</a>
      </nav>
      <a class="header-contact" href={`mailto:${contactEmail}`}><span>{t.nav.contact}</span><Icon name="arrow-up-right" /></a>
    </div>
  </div>
</header>
<MobileNavigation lang={lang} experience={experience} languageHref={altPath} contactEmail={contactEmail} />

<style>
  /* The sentinel changes state once at the threshold, without a scroll listener. */
  .header-scroll-sentinel {
    position: absolute;
    inset-block-start: var(--space-xl);
    inset-inline-start: 0;
    width: var(--rule-hair);
    height: var(--rule-hair);
    pointer-events: none;
  }
  .site-header.site-header--floating {
    align-self: center;
    width: min(calc(100% - var(--page-gutter) * 2), var(--size-header-expanded));
    margin: var(--space-md) 0 0;
    inset-block-start: var(--space-md);
    border: 0;
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }
  .site-header .site-header__inner {
    position: relative;
    isolation: isolate;
    width: 100%;
    margin-inline: auto;
    min-height: var(--size-header-compact);
    padding: var(--space-xs) var(--space-sm) var(--space-xs) var(--space-lg);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-sm);
    border: var(--rule-hair) solid transparent;
    border-radius: var(--radius-header);
    background: transparent;
  }
  .site-header[data-header-condensed] .site-header__inner {
    width: min(100%, var(--size-header-capsule));
  }
  .header-surface {
    position: absolute;
    z-index: var(--layer-behind);
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    transform-origin: top left;
    opacity: 0;
    transition: opacity var(--dur-header) var(--ease-out);
  }
  .header-surface--shadow { box-shadow: var(--shadow-header); }
  .header-surface--glass {
    border: var(--rule-hair) solid color-mix(in oklch, var(--color-rule) var(--opacity-header-rule), transparent);
    background: var(--color-paper-2);
    /* Clip backdrop paint to rounded corners without clipping the separate shadow. */
    clip-path: border-box;
  }
  .site-header__inner > :not(.header-surface) { position: relative; }
  .site-header[data-header-condensed] .header-surface { opacity: 1; }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .header-surface--glass {
      background: color-mix(in oklch, var(--color-paper-2) var(--opacity-header-surface), transparent);
      -webkit-backdrop-filter: blur(var(--blur-header));
      backdrop-filter: blur(var(--blur-header));
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .header-surface--glass {
      background: var(--color-paper-2);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  .site-header .wordmark {
    gap: 0;
    font-size: var(--text-base);
    color: var(--color-ink);
  }
  .site-header .wordmark > .wordmark__mobile { display: none; }
  .site-header .wordmark > .wordmark__letters {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: auto;
    line-height: var(--leading-wordmark);
    white-space: nowrap;
    color: inherit;
  }
  .wordmark__letter { display: block; }
  .wordmark__suffix {
    display: block;
    position: absolute;
    inset-inline-start: 0;
    opacity: 0;
  }
  .site-header[data-header-condensed] .wordmark { color: var(--color-accent); }
  .site-header[data-header-condensed] .wordmark__letter--initial { text-transform: lowercase; }
  .site-header[data-header-condensed] .wordmark__suffix {
    position: relative;
    opacity: 1;
  }
  .site-header[data-header-condensed] .wordmark__letter:not(.wordmark__letter--initial) {
    position: absolute;
    inset-inline-start: 0;
    opacity: 0;
  }
  .header-navigation {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-xs) var(--space-xs) 0;
  }
  .header-experiences { grid-column: 1 / -1; display: grid; gap: var(--space-xs); }
  .header-experiences a {
    display: flex;
    align-items: center;
    min-height: var(--size-control);
    color: var(--color-muted);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }
  .header-experiences a[data-active-section] { color: var(--color-focus); }
  .header-experiences a:hover { color: var(--color-ink); }
  .header-experiences a:focus-visible { border-radius: var(--radius-sm); }
  .header-tools { display: flex; gap: var(--space-2xs); }
  .header-tools .theme-button, .header-tools .language-link { border-radius: var(--radius-round); }
  .header-tools .theme-button:hover, .header-tools .language-link:hover { background: var(--color-paper-3); }
  .header-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: var(--size-control);
    padding-inline: var(--space-lg);
    border-radius: var(--radius-round);
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .header-contact:hover { background: var(--color-ink-2); }
  .header-contact .icon { transition: transform var(--dur-short) var(--ease-out); }
  .header-contact:hover .icon { transform: translate(var(--space-3xs), calc(-1 * var(--space-3xs))); }
  @media (max-width: 63.99rem) {
    .site-header.site-header--floating { position: static; }
    .site-header .site-header__inner { padding-inline: 0; border-radius: 0; }
    .site-header .header-navigation,
    .site-header .header-surface,
    .site-header .wordmark > .wordmark__letters { display: none; }
    .site-header .wordmark > .wordmark__mobile {
      display: block;
      width: auto;
      color: var(--color-ink);
      line-height: var(--leading-wordmark);
      white-space: nowrap;
    }
    .wordmark__mobile > span { color: var(--color-accent); }
  }
  @media (min-width: 64rem) {
    .site-header .site-header__inner { grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--space-md); border-radius: var(--radius-round); }
    .header-navigation { display: contents; }
    .header-experiences {
      position: absolute;
      grid-area: auto;
      inset-inline-start: 50%;
      inset-block-start: 50%;
      display: flex;
      gap: var(--space-lg);
      margin: 0;
      transform: translate(-50%, -50%);
    }
    .header-tools { grid-column: 2; grid-row: 1; }
    .header-contact { grid-column: 3; grid-row: 1; }
    .header-experiences a { font-size: var(--text-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-surface,
    .header-contact .icon { transition: none; }
    .header-contact:hover .icon { transform: none; }
  }
</style>

<script>
  let scrollObserver: IntersectionObserver | undefined;
  let headerAnimations: Animation[] = [];
  const desktopHeader = window.matchMedia('(min-width: 64rem)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const stopHeaderAnimations = () => {
    headerAnimations.forEach((animation) => animation.cancel());
    headerAnimations = [];
  };
  const setHeaderCondensed = (header: HTMLElement, condensed: boolean, animate = true) => {
    if (header.hasAttribute('data-header-condensed') === condensed) return;
    if (!animate || reducedMotion.matches) {
      stopHeaderAnimations();
      header.toggleAttribute('data-header-condensed', condensed);
      return;
    }

    // Measure each endpoint once. The centered links stay still while the surface
    // and outer controls move; text is never scaled and no layout runs per frame.
    const elements = Array.from(header.querySelectorAll<HTMLElement>(
      '.header-surface, .wordmark, .header-tools, .header-contact',
    ));
    const name = header.querySelector<HTMLElement>('.wordmark__letters')!;
    const letters = Array.from(name.querySelectorAll<HTMLElement>('[data-wordmark-letter]'));
    const suffix = name.querySelector<HTMLElement>('[data-wordmark-suffix]')!;
    const nameBefore = name.getBoundingClientRect();
    const lettersBefore = letters.map((letter) => {
      const rect = letter.getBoundingClientRect();
      return { x: rect.left - nameBefore.left, width: rect.width, opacity: getComputedStyle(letter).opacity };
    });
    const suffixBefore = { x: suffix.getBoundingClientRect().left - nameBefore.left, opacity: getComputedStyle(suffix).opacity };
    const interrupted = headerAnimations.some((animation) => animation.playState === 'running');
    const before = elements.map((element) => element.getBoundingClientRect());
    stopHeaderAnimations();
    header.toggleAttribute('data-header-condensed', condensed);
    const after = elements.map((element) => element.getBoundingClientRect());
    const nameAfter = name.getBoundingClientRect();
    const lettersAfter = letters.map((letter) => letter.getBoundingClientRect().left - nameAfter.left);
    const suffixAfter = suffix.getBoundingClientRect().left - nameAfter.left;
    const style = getComputedStyle(header);
    const duration = parseFloat(style.getPropertyValue('--dur-header'));
    const easing = style.getPropertyValue('--ease-header').trim();
    headerAnimations = elements.flatMap((element, index) => {
      const from = before[index];
      const to = after[index];
      if (!from.width || !to.width) return [];
      const x = from.left - to.left;
      const y = from.top - to.top;
      const scale = element.classList.contains('header-surface') ? from.width / to.width : 1;
      if (!x && !y && scale === 1) return [];
      return [element.animate([
        { transform: `translate(${x}px, ${y}px) scaleX(${scale})` },
        { transform: 'none' },
      ], { duration, easing })];
    });

    // Remove the non-initial letters in the same left-to-right rhythm as the
    // reference. Stepped transforms reproduce the contraction without width tweens.
    const collapse = parseFloat(style.getPropertyValue('--dur-header-letter'));
    const fade = parseFloat(style.getPropertyValue('--dur-header-letter-fade'));
    const stagger = parseFloat(style.getPropertyValue('--delay-header-letter'));
    const drops = letters.flatMap((letter, index) => letter.classList.contains('wordmark__letter--initial')
      ? [] : [{ index, width: lettersBefore[index].width }]);
    const nameDuration = collapse + Math.max(0, drops.length - 1) * stagger;
    let compactX = 0;
    letters.forEach((letter, index) => {
      const initial = letter.classList.contains('wordmark__letter--initial');
      const targetOpacity = initial || !condensed ? '1' : '0';
      const from = lettersBefore[index];
      const to = lettersAfter[index];
      if (interrupted) {
        headerAnimations.push(letter.animate([
          { transform: `translateX(${from.x - to}px)`, opacity: from.opacity },
          { transform: 'none', opacity: targetOpacity },
        ], { duration, easing }));
      } else {
        let position = condensed ? from.x : compactX;
        const frames: Keyframe[] = [{ offset: 0, transform: `translateX(${position - to}px)`, easing: 'steps(1, end)' }];
        drops.forEach((drop, order) => {
          if (drop.index >= index) return;
          position += (condensed ? -1 : 1) * drop.width;
          frames.push({
            offset: (collapse + order * stagger) / nameDuration,
            transform: `translateX(${position - to}px)`,
            easing: 'steps(1, end)',
          });
        });
        frames.push({ offset: 1, transform: 'none' });
        headerAnimations.push(letter.animate(frames, { duration: nameDuration }));
        if (!initial) {
          const order = drops.findIndex((drop) => drop.index === index);
          headerAnimations.push(letter.animate([
            { opacity: from.opacity }, { opacity: targetOpacity },
          ], { duration: condensed ? fade : collapse, delay: order * stagger, easing: condensed ? 'ease' : 'steps(1, end)', fill: 'backwards' }));
        }
      }
      if (initial) compactX += from.width;
    });
    headerAnimations.push(suffix.animate([
      { opacity: suffixBefore.opacity, transform: condensed ? 'none' : `translateX(${suffixBefore.x - suffixAfter}px)` },
      { opacity: condensed ? '1' : '0', transform: 'none' },
    ], { duration: fade, delay: condensed && !interrupted ? nameDuration : 0, fill: 'backwards' }));
  };
  const initializeMenu = () => {
    scrollObserver?.disconnect();
    stopHeaderAnimations();
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const sentinel = document.querySelector('[data-header-sentinel]');
    if (!header || !sentinel) return;
    if (!desktopHeader.matches) {
      header.removeAttribute('data-header-condensed');
      return;
    }
    setHeaderCondensed(header, sentinel.getBoundingClientRect().bottom <= 0, false);
    scrollObserver = new IntersectionObserver(([entry]) => {
      setHeaderCondensed(header, !entry.isIntersecting && entry.boundingClientRect.top < 0);
    });
    scrollObserver.observe(sentinel);
  };
  initializeMenu();
  desktopHeader.addEventListener('change', initializeMenu);
  reducedMotion.addEventListener('change', stopHeaderAnimations);
  window.addEventListener('resize', stopHeaderAnimations, { passive: true });
  document.addEventListener('astro:before-swap', () => {
    scrollObserver?.disconnect();
    stopHeaderAnimations();
  });
  document.addEventListener('astro:after-swap', initializeMenu);
  document.addEventListener('astro:page-load', initializeMenu);
  const syncThemeLabel = () => {
    const root = document.documentElement;
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((themeButton) => {
      if (themeButton.hasAttribute('data-theme-switch')) {
        themeButton.setAttribute('aria-checked', String(dark));
        return;
      }
      const nextLabel = dark
        ? themeButton.dataset.themeLightLabel
        : themeButton.dataset.themeDarkLabel;
      if (!nextLabel) return;
      themeButton.setAttribute('aria-label', nextLabel);
      themeButton.setAttribute('title', nextLabel);
    });
  };
  syncThemeLabel();
  document.addEventListener('astro:page-load', syncThemeLabel);

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (event.target.closest('[data-theme-toggle]')) {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* The theme also works without storage. */ }
      syncThemeLabel();
    }
  });
</script>
