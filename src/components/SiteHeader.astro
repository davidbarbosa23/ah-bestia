---
import { alternatePath, copy, ui, type Lang } from '../i18n/content';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  experience?: 'developer' | 'photographer';
  languageHref?: string;
  quiet?: boolean;
}
const { lang, experience, languageHref, quiet = false } = Astro.props;
const t = copy[lang];
const labels = ui[lang];
const altLang = lang === 'en' ? 'es' : 'en';
const altPath = languageHref ?? alternatePath(Astro.url.pathname, lang);
const homePath = `/${lang}/${experience === 'photographer' ? 'ph' : 'dev'}/`;
---

<header class:list={['site-header', experience && `site-header--${experience}`, quiet && 'site-header--quiet']} data-site-header>
  <div class="site-header__inner">
    <a class="wordmark" href={homePath} aria-label={labels.common.homeLabel}>
      <span aria-hidden="true">db/</span><span>David Barbosa</span>
    </a>

    {experience && (
      <nav class="experience-switch" aria-label={t.modes.label}>
        <a class:list={['experience-switch__option', experience === 'developer' && 'is-active']} href={`/${lang}/dev/`} aria-current={experience === 'developer' ? 'page' : undefined} aria-label={t.modes.developer}>
          <span class="switch-wide">{t.modes.developer}</span><span class="switch-short" aria-hidden="true">DEV</span>
        </a>
        <a class:list={['experience-switch__option', experience === 'photographer' && 'is-active']} href={`/${lang}/ph/`} aria-current={experience === 'photographer' ? 'page' : undefined} aria-label={t.modes.photographer}>
          <span class="switch-wide">{t.modes.photographer}</span><span class="switch-short" aria-hidden="true">PHOTO</span>
        </a>
      </nav>
    )}

    <nav class="site-tools" aria-label={labels.common.utilityNavigation}>
      <button class="theme-button" type="button" data-theme-toggle data-theme-light-label={t.theme.light} data-theme-dark-label={t.theme.dark} aria-label={t.theme.light} title={t.theme.light}>
        <Icon name="sun" class="theme-icon theme-icon--sun" />
        <Icon name="moon" class="theme-icon theme-icon--moon" />
      </button>
      <a class="language-link" href={altPath} hreflang={altLang} lang={altLang} aria-label={labels.common.switchLanguage} title={labels.common.switchLanguage} data-language-link>{altLang.toUpperCase()}</a>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 767px) {
    :global(.site-header--developer .theme-button), :global(.site-header--developer .language-link) { width: var(--size-control-sm); }
    :global(.site-header--developer .experience-switch) { height: var(--size-control-sm); grid-template-columns: repeat(2, minmax(var(--size-control-sm), 1fr)); }
  }
  @media (max-width: 359px) {
    :global(.site-header--developer .site-header__inner) { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-xs); }
    :global(.site-header--developer .experience-switch) { grid-column: 1 / -1; grid-row: 2; }
    :global(.site-header--developer .site-tools) { grid-column: 2; grid-row: 1; }
  }
</style>

<script>
  const syncThemeLabel = () => {
    const root = document.documentElement;
    const themeButton = document.querySelector('[data-theme-toggle]');
    if (!(themeButton instanceof HTMLElement)) return;
    const dark = root.dataset.theme === 'dark';
    const nextLabel = dark
      ? themeButton.dataset.themeLightLabel
      : themeButton.dataset.themeDarkLabel;
    if (!nextLabel) return;
    themeButton.setAttribute('aria-label', nextLabel);
    themeButton.setAttribute('title', nextLabel);
  };
  syncThemeLabel();
  document.addEventListener('astro:page-load', syncThemeLabel);

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (event.target.closest('[data-theme-toggle]')) {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* The theme also works without storage. */ }
      syncThemeLabel();
    }
  });
</script>
