---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import DeveloperHome from '../../../components/DeveloperHome.astro';
import { copy, languages, type Lang } from '../../../i18n/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<SiteLayout lang={lang} experience="developer" title={t.meta.homeTitle} description={t.meta.homeDescription} schemaType="ProfilePage">
  <SiteHeader lang={lang} experience="developer" />
  <DeveloperHome lang={lang} />
  <SiteFooter lang={lang} />
</SiteLayout>

<script>
  let revealObserver: IntersectionObserver | undefined;
  let developerAnimations: Animation[] = [];

  const teardownDeveloperAnimations = () => {
    revealObserver?.disconnect();
    revealObserver = undefined;
    developerAnimations.forEach((animation) => animation.cancel());
    developerAnimations = [];
  };

  const setupDeveloperAnimations = () => {
    teardownDeveloperAnimations();
    const hero = document.querySelector('.dev-hero');
    const isLanguageTransition = document.documentElement.dataset.languageTransition === 'true';
    if (!hero || isLanguageTransition || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const easing = 'cubic-bezier(0.16, 1, 0.3, 1)';
    const animateIntro = (
      selector: string,
      transform: string,
      duration: number,
      startDelay: number,
      stagger = 0,
    ) => {
      document.querySelectorAll<HTMLElement>(selector).forEach((element, index) => {
        const animation = element.animate(
          [
            { opacity: 0, transform },
            { opacity: 1, transform: 'none' },
          ],
          { duration, delay: startDelay + index * stagger, easing, fill: 'backwards' },
        );
        developerAnimations.push(animation);
      });
    };

    animateIntro('.dev-hero .status-line', 'translateY(10px)', 360, 0);
    animateIntro('.dev-hero h1 span', 'translateY(24%)', 720, 80, 80);
    animateIntro('.dev-hero__intro, .dev-hero__actions', 'translateY(12px)', 480, 260, 80);
    animateIntro('.source-card', 'translateX(18px)', 680, 340);

    revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
        revealObserver?.unobserve(entry.target);
        const animation = entry.target.animate(
          [
            { opacity: 0, transform: 'translateY(18px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 620, easing, fill: 'backwards' },
        );
        developerAnimations.push(animation);
      });
    }, { rootMargin: '0px 0px 14% 0px' });

    document.querySelectorAll<HTMLElement>('.reveal-item').forEach((item) => revealObserver?.observe(item));
  };

  document.addEventListener('astro:page-load', setupDeveloperAnimations);
</script>
