---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import DeveloperHome from '../../../components/DeveloperHome.astro';
import { copy, languages, type Lang } from '../../../i18n/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<SiteLayout lang={lang} experience="developer" title={t.meta.homeTitle} description={t.meta.homeDescription} schemaType="ProfilePage">
  <SiteHeader lang={lang} experience="developer" />
  <DeveloperHome lang={lang} />
  <SiteFooter lang={lang} />
</SiteLayout>
