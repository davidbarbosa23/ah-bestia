---
import '../../../../styles/lab-article.css';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import FixedGearCalculator from '../../../../components/FixedGearCalculator.astro';
import Icon from '../../../../components/Icon.astro';
import { languages, ui, type Lang } from '../../../../i18n/content';
import { labProjects, labsCopy, type LabProject } from '../../../../data/labs';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    labProjects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}

interface Props { project: LabProject; }

const { project } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const t = labsCopy[lang];
const content = project.content[lang];
---

<SiteLayout
  lang={lang}
  experience="developer"
  title={`${content.title} - ${t.metaTitle}`}
  description={content.summary}
  pageType="article"
  schemaType="Article"
>
  <SiteHeader lang={lang} experience="developer" />
  <main class="lab-article" id="main">
    <FixedGearCalculator lang={lang} backLabel={t.projectBack} />
    <article>
      <header class="lab-hero page-shell">
        <h2>{content.title}</h2>
        <p class="lab-hero__lede">{content.lede}</p>
        <dl class="lab-hero__meta">
          <div><dt>{ui[lang].labs.status}</dt><dd>{content.status}</dd></div>
          <div><dt>{t.builtWith}</dt><dd>{project.tags.join(' · ')}</dd></div>
          <div><dt>{t.reference}</dt><dd><a href="https://www.surplace.fr/ffgc/" target="_blank" rel="noreferrer">{t.referenceText} <Icon name="arrow-up-right" /><span class="sr-only"> ({ui[lang].common.opensInNewTab})</span></a></dd></div>
        </dl>
      </header>

      <section class="lab-note page-shell" aria-labelledby="lab-question">
        <h2 id="lab-question">{content.question}</h2>
        <p>{content.questionBody}</p>
      </section>

      <div class="lab-notes page-shell">
        <section>
          <h2>{content.approach}</h2>
          <p>{content.approachBody}</p>
        </section>
        <section>
          <h2>{content.result}</h2>
          <p>{content.resultBody}</p>
        </section>
      </div>

      <aside class="lab-next page-shell">
        <p class="mono-label">{t.next}</p>
        <p>{t.nextText}</p>
      </aside>
    </article>
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
