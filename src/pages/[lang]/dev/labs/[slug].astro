---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import FixedGearCalculator from '../../../../components/FixedGearCalculator.astro';
import { languages, type Lang } from '../../../../i18n/content';
import { labProjects, labsCopy, type LabProject } from '../../../../data/labs';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    labProjects.map((project) => ({
      params: { lang, slug: project.slug },
      props: { project },
    })),
  );
}

interface Props { project: LabProject; }

const { project } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const t = labsCopy[lang];
const content = project.content[lang];
---

<SiteLayout
  lang={lang}
  experience="developer"
  title={`${content.title} — ${t.metaTitle}`}
  description={content.summary}
  pageType="article"
>
  <SiteHeader lang={lang} experience="developer" />
  <main class="lab-article" id="main">
    <div class="page-shell">
      <a class="inner-page__back" href={`/${lang}/dev/labs/`}>
        <span aria-hidden="true">←</span>{t.projectBack}
      </a>
    </div>

    <article>
      <header class="lab-hero page-shell">
        <p class="mono-label">{t.projectLabel}</p>
        <h1>{content.title}</h1>
        <p class="lab-hero__lede">{content.lede}</p>
        <dl class="lab-hero__meta">
          <div><dt>{lang === 'en' ? 'Status' : 'Estado'}</dt><dd>{content.status}</dd></div>
          <div><dt>{t.builtWith}</dt><dd>{project.tags.join(' · ')}</dd></div>
          <div><dt>{t.reference}</dt><dd><a href="https://www.surplace.fr/ffgc/" target="_blank" rel="noreferrer">{t.referenceText} ↗</a></dd></div>
        </dl>
      </header>

      <section class="lab-note page-shell" aria-labelledby="lab-question">
        <h2 id="lab-question">{content.question}</h2>
        <p>{content.questionBody}</p>
      </section>

      <div class="lab-live page-shell">
        <FixedGearCalculator lang={lang} />
      </div>

      <div class="lab-notes page-shell">
        <section>
          <p class="mono-label">01 / input</p>
          <h2>{content.approach}</h2>
          <p>{content.approachBody}</p>
        </section>
        <section>
          <p class="mono-label">02 / output</p>
          <h2>{content.result}</h2>
          <p>{content.resultBody}</p>
        </section>
      </div>

      <aside class="lab-next page-shell">
        <p class="mono-label">{t.next}</p>
        <p>{t.nextText}</p>
      </aside>
    </article>
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
