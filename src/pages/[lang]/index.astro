---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DeveloperHome from '../../components/DeveloperHome.astro';
import PhotographyHome from '../../components/PhotographyHome.astro';
import { copy, languages, type Lang } from '../../i18n/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<SiteLayout lang={lang} title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <SiteHeader lang={lang} home />
  <DeveloperHome lang={lang} />
  <PhotographyHome lang={lang} />
  <SiteFooter lang={lang} />
</SiteLayout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const body = document.body;
  const panels = [...document.querySelectorAll('[data-experience-panel]')];
  const modeButtons = [...document.querySelectorAll('[data-mode-button]')];
  const setMode = (mode: 'developer' | 'photographer', animate = true) => {
    const current = body.dataset.experience;
    if (current === mode && animate) return;
    const incoming = panels.find((panel) => panel.getAttribute('data-experience-panel') === mode);
    const outgoing = panels.find((panel) => !panel.hasAttribute('hidden'));
    const finish = () => {
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-experience-panel') === mode;
        if (panel instanceof HTMLElement) {
          panel.hidden = !active;
          panel.inert = !active;
        }
      });
      body.dataset.experience = mode;
      const skipLink = document.querySelector('.skip-link');
      if (skipLink instanceof HTMLAnchorElement) skipLink.href = mode === 'photographer' ? '#photo-main' : '#main';
      modeButtons.forEach((button) => {
        const active = button.getAttribute('data-mode-button') === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      sessionStorage.setItem('experience', mode);
      window.scrollTo({ top: 0, behavior: 'instant' });
      requestAnimationFrame(() => ScrollTrigger.refresh());
      if (animate && incoming) gsap.fromTo(incoming, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.42, ease: 'power2.out' });
    };
    if (animate && outgoing) {
      gsap.to(outgoing, { autoAlpha: 0, duration: 0.18, ease: 'power2.in', onComplete: finish });
    } else finish();
  };

  modeButtons.forEach((button) => button.addEventListener('click', () => {
    const mode = button.getAttribute('data-mode-button');
    if (mode === 'developer' || mode === 'photographer') setMode(mode);
  }));

  const remembered = sessionStorage.getItem('experience');
  if (remembered === 'photographer') setMode('photographer', false);

  const mm = gsap.matchMedia();
  mm.add({
    allowMotion: '(prefers-reduced-motion: no-preference)',
    desktop: '(min-width: 60rem)',
  }, (context) => {
    const { allowMotion, desktop } = context.conditions as { allowMotion: boolean; desktop: boolean };
    if (!allowMotion) return;

    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
    intro
      .from('.dev-hero .status-line', { autoAlpha: 0, y: 10, duration: 0.36 })
      .from('.dev-hero h1 span', { autoAlpha: 0, yPercent: 24, duration: 0.72, stagger: 0.08 }, '<0.08')
      .from('.dev-hero__intro, .dev-hero__actions', { autoAlpha: 0, y: 12, duration: 0.48, stagger: 0.08 }, '<0.18')
      .from('.source-card', { autoAlpha: 0, x: 18, duration: 0.68 }, '<0.08');

    gsap.utils.toArray<HTMLElement>('.reveal-item').forEach((item) => {
      gsap.from(item, {
        autoAlpha: 0,
        y: 18,
        duration: 0.62,
        ease: 'power2.out',
        scrollTrigger: { trigger: item, start: 'top 86%', once: true },
      });
    });

    if (desktop) {
      const section = document.querySelector('[data-horizontal-section]');
      const track = document.querySelector('[data-photo-track]');
      if (section instanceof HTMLElement && track instanceof HTMLElement) {
        const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + 64);
        gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 0.8,
            invalidateOnRefresh: true,
          },
        });
      }
    }
  });

  window.addEventListener('pagehide', () => mm.revert(), { once: true });
</script>
