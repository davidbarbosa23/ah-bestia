---
import { Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { languages, type Lang } from '../../../i18n/content';
import { getNextGallery, photoGalleries, type PhotoGallery } from '../../../data/photoGalleries';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    photoGalleries.map((gallery) => ({
      params: { lang, slug: gallery.slug },
      props: { gallery },
    })),
  );
}

interface Props {
  gallery: PhotoGallery;
}

const { gallery } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const content = gallery.content[lang];
const nextGallery = getNextGallery(gallery.slug);
const nextContent = nextGallery.content[lang];
const galleryImages = gallery.images.filter(({ filename }) => filename !== gallery.coverFilename);
const labels = lang === 'en'
  ? {
      back: 'Back to all series',
      kicker: 'Photographic series',
      photographs: 'photographs',
      source: 'Archive folder',
      next: 'Next series',
      photo: 'Photograph',
      from: 'from',
    }
  : {
      back: 'Volver a todas las series',
      kicker: 'Serie fotográfica',
      photographs: 'fotografías',
      source: 'Carpeta del archivo',
      next: 'Siguiente serie',
      photo: 'Fotografía',
      from: 'de',
    };
---

<SiteLayout
  lang={lang}
  experience="photographer"
  title={`${content.title} — David Barbosa`}
  description={content.description}
  image={gallery.cover.src}
  imageAlt={`${content.cardTitle}. ${content.description}`}
  pageType="article"
>
  <SiteHeader lang={lang} experience="photographer" />
  <main class="article-page series-page" id="main">
    <div class="page-shell">
      <a class="inner-page__back" href={`/${lang}/ph/`}><span aria-hidden="true">←</span>{labels.back}</a>
    </div>

    <header class="article-hero series-hero">
      <Image
        src={gallery.cover}
        widths={[480, 720, 1080, 1400]}
        sizes="100vw"
        quality={88}
        fetchpriority="high"
        alt={`${content.cardTitle}. ${content.description}`}
      />
      <div class="article-hero__copy page-shell">
        <p class="mono-label">{labels.kicker} · {content.location}</p>
        <h1>{content.title}</h1>
        <p>{content.description}</p>
      </div>
    </header>

    <article class="series-body page-shell">
      <header class="series-body__meta">
        <p><strong>{gallery.images.length}</strong> {labels.photographs}</p>
        <p><span>{labels.source}</span> {gallery.sourceFolder}</p>
      </header>

      <div class="series-gallery">
        {galleryImages.map(({ image, filename }, index) => {
          const number = index + 2;
          const alt = `${labels.photo} ${number} ${labels.from} ${content.title}`;
          const isLandscape = image.width > image.height;

          return (
            <figure class:list={['series-photo', (isLandscape || index % 9 === 7) && 'series-photo--wide']}>
              <Image
                src={image}
                widths={[480, 800, 1200, 1600]}
                sizes={isLandscape ? '100vw' : '(min-width: 40rem) 50vw, 100vw'}
                quality={86}
                loading="lazy"
                alt={alt}
              />
              <figcaption>
                <span>{String(number).padStart(2, '0')} / {String(gallery.images.length).padStart(2, '0')}</span>
                <span aria-hidden="true">{filename}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>

      <a class="article-next" href={`/${lang}/ph/${nextGallery.slug}/`}>
        <span>{labels.next}</span>
        <strong>{nextContent.title} <span aria-hidden="true">→</span></strong>
      </a>
    </article>
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
