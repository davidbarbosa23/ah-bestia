---
import { getImage, Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import PhotoMagazine from '../../../components/PhotoMagazine.astro';
import Icon from '../../../components/Icon.astro';
import { languages, ui, type Lang } from '../../../i18n/content';
import {
  getNextGallery,
  getPreviousGallery,
  photoGalleries,
  type PhotoGallery,
} from '../../../data/photoGalleries';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    photoGalleries.map((gallery) => ({
      params: { lang, slug: gallery.slug },
      props: { gallery },
    })),
  );
}

interface Props {
  gallery: PhotoGallery;
}

const { gallery } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const content = gallery.content[lang];
const previousGallery = getPreviousGallery(gallery.slug);
const nextGallery = getNextGallery(gallery.slug);
const galleryIndex = photoGalleries.findIndex(({ slug }) => slug === gallery.slug);
const previousContent = previousGallery.content[lang];
const nextContent = nextGallery.content[lang];
const labels = ui[lang].photography.series;
const seriesNumber = String(galleryIndex + 1).padStart(2, '0');
const seriesTotal = String(photoGalleries.length).padStart(2, '0');
const galleryImages = [
  ...gallery.images.filter(({ filename }) => filename === gallery.coverFilename),
  ...gallery.images.filter(({ filename }) => filename !== gallery.coverFilename),
];
const galleryViewerImages = gallery.magazine
  ? []
  : await Promise.all(
      galleryImages.map(async ({ image, filename }) => ({
        image,
        filename,
        viewer: await getImage({
          src: image,
          width: Math.min(1600, image.width),
          format: 'webp',
          quality: 80,
        }),
      })),
    );
const presentedImageCount = gallery.magazine?.pages.length ?? gallery.images.length;
let hasUnpairedNarrowImage = false;
const storyViewerImages = galleryViewerImages.map((entry, index) => {
  const ratio = entry.image.width / entry.image.height;
  const isLandscape = ratio >= 1.12;
  const isFeature = !isLandscape && (index + 1) % 7 === 0;

  if (isLandscape || isFeature) {
    hasUnpairedNarrowImage = false;
    return { ...entry, layout: isLandscape ? 'wide' : 'feature' };
  }

  const layout = hasUnpairedNarrowImage ? 'right' : 'left';
  hasUnpairedNarrowImage = !hasUnpairedNarrowImage;
  return { ...entry, layout };
});
const formatLabel = gallery.magazine ? labels.magazineEdition : labels.sequence;
---

<SiteLayout
  lang={lang}
  experience="photographer"
  title={`${content.title} — ${ui[lang].photography.metaTitleSuffix}`}
  description={content.description}
  image={gallery.cover}
  imageAlt={`${content.cardTitle}. ${content.description}`}
  pageType="article"
  schemaType="ImageGallery"
>
  <SiteHeader lang={lang} experience="photographer" />
  <main class="article-page series-page" id="main">
    <div class="series-masthead page-shell">
      <a class="inner-page__back" href={`/${lang}/ph/`}><Icon name="arrow-left" />{labels.back}</a>
      <p>{seriesNumber} / {seriesTotal}</p>
    </div>

    <header class="series-opening page-shell">
      <div class="series-opening__copy">
        <div>
          <p class="mono-label">{labels.kicker} · {content.location}</p>
          <h1>{content.title}</h1>
        </div>
        <div class="series-opening__summary">
          <p>{content.description}</p>
          <p class="series-opening__facts">
            <span>{presentedImageCount} {ui[lang].photography.photographs}</span>
            <span>{formatLabel}</span>
          </p>
        </div>
      </div>

    </header>

    <article class="series-body page-shell">
      <nav class="series-path" aria-label={`${labels.previous} / ${labels.next}`}>
        <a class="series-path__link series-path__link--previous" href={`/${lang}/ph/${previousGallery.slug}/`} rel="prev">
          <svg viewBox="0 0 32 16" aria-hidden="true"><path d="M30 8H3M9 2 3 8l6 6" /></svg>
          <span><small>{labels.previous}</small><strong>{previousContent.title}</strong></span>
        </a>
        <p class="series-path__current"><span>{seriesNumber} / {seriesTotal}</span><span>{formatLabel}</span></p>
        <a class="series-path__link series-path__link--next" href={`/${lang}/ph/${nextGallery.slug}/`} rel="next">
          <span><small>{labels.next}</small><strong>{nextContent.title}</strong></span>
          <svg viewBox="0 0 32 16" aria-hidden="true"><path d="M2 8h27m-6-6 6 6-6 6" /></svg>
        </a>
      </nav>

      {gallery.magazine ? (
        <PhotoMagazine gallery={gallery} lang={lang} />
      ) : (
        <div class="series-gallery" aria-label={`${content.title} — ${ui[lang].photography.photographs}`}>
          {storyViewerImages.map(({ image, filename, viewer, layout }, index) => {
            const number = index + 1;
            const alt = `${labels.photo} ${number} ${labels.from} ${content.title}`;

            return (
              <figure class:list={['series-photo', `series-photo--${layout}`]}>
                <button
                  class="series-photo__open"
                  type="button"
                  aria-label={`${labels.openFullscreen}: ${alt}`}
                  aria-haspopup="dialog"
                  aria-controls="photo-lightbox"
                  data-lightbox-open
                  data-lightbox-src={viewer.src}
                  data-lightbox-alt={alt}
                  data-lightbox-filename={filename}
                >
                  <Image
                    src={image}
                    widths={[480, 800, 1200, 1600]}
                    sizes={layout === 'wide' ? '(min-width: 92rem) 92rem, 100vw' : '(min-width: 60rem) 46rem, (min-width: 40rem) 58vw, 100vw'}
                    quality={index === 0 ? 84 : 80}
                    priority={index === 0}
                    alt={alt}
                    transition:name={index === 0 ? `gallery-cover-${gallery.slug}` : undefined}
                  />
                  <span class="series-photo__expand"><Icon name="arrow-up-right" /></span>
                </button>
                <figcaption>
                  <span>{String(number).padStart(2, '0')} / {String(presentedImageCount).padStart(2, '0')}</span>
                  <span aria-hidden="true">{filename}</span>
                </figcaption>
              </figure>
            );
          })}
        </div>
      )}

      <footer class="series-continuation">
        <a href={`/${lang}/ph/${nextGallery.slug}/`} data-series-transition rel="next">
          <div class="series-continuation__copy">
            <span>{labels.continueWith}</span>
            <strong>{nextContent.title}</strong>
            <p>{nextContent.location} · {nextGallery.images.length} {ui[lang].photography.photographs}</p>
            <Icon name="arrow-right" />
          </div>
          <figure>
            <Image
              src={nextGallery.cover}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 90rem) 39rem, (min-width: 60rem) 50vw, 100vw"
              quality={82}
              loading="lazy"
              alt={`${nextContent.cardTitle}. ${nextContent.description}`}
              transition:name={`gallery-cover-${nextGallery.slug}`}
            />
          </figure>
        </a>
      </footer>
    </article>
    {!gallery.magazine && <PhotoLightbox lang={lang} />}
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
