---
import '../../../styles/photo-series.css';
import { getImage, Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import PhotoMagazine from '../../../components/PhotoMagazine.astro';
import Icon from '../../../components/Icon.astro';
import { languages, ui, type Lang } from '../../../i18n/content';
import {
  getNextGallery,
  getPreviousGallery,
  photoGalleries,
  photoSequence,
  type PhotoGallery,
} from '../../../data/photoGalleries';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    photoGalleries.map((gallery) => ({
      params: { lang, slug: gallery.slug },
      props: { gallery },
    })),
  );
}

interface Props {
  gallery: PhotoGallery;
}

const { gallery } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const content = gallery.content[lang];
const previousGallery = getPreviousGallery(gallery.slug);
const nextGallery = getNextGallery(gallery.slug);
const galleryIndex = photoSequence.findIndex(({ slug }) => slug === gallery.slug);
const previousContent = previousGallery.content[lang];
const nextContent = nextGallery.content[lang];
const labels = ui[lang].photography.series;
const seriesNumber = String(galleryIndex + 1).padStart(2, '0');
const seriesTotal = String(photoGalleries.length).padStart(2, '0');
const storyPhotos = gallery.story.flatMap(({ photos }) => photos);
const galleryViewerImages = await Promise.all(
  storyPhotos.map(async (photo, index) => {
    const widths = [...new Set([480, 720, 960, 1200, Math.min(1600, photo.image.width)])]
      .filter((width) => width <= photo.image.width);
    const avif = await Promise.all(widths.map((width) => getImage({ src: photo.image, width, format: 'avif', quality: 60 })));
    return {
      ...photo,
      number: index + 1,
      // Preserve every available source pixel in the fullscreen viewer.
      viewer: photo.image,
      avifSrcset: avif.map(({ src, attributes }) => `${src} ${attributes.width}w`).join(', '),
    };
  }),
);
const viewerPhotos = new Map(galleryViewerImages.map((photo) => [photo.filename, photo]));
const storyViewerSpreads = gallery.story.map(({ layout, photos }) => ({
  layout,
  photos: photos.map(({ filename }) => viewerPhotos.get(filename)!),
}));
const presentedImageCount = gallery.magazine?.pages.length ?? storyPhotos.length;
const openingImageCount = gallery.story[0]?.photos.length ?? 0;
const imageSizes = {
  pair: '(min-width: 92rem) 42rem, (min-width: 40rem) 46vw, 92vw',
  feature: '(min-width: 92rem) 56rem, (min-width: 40rem) 62vw, 92vw',
  wide: '(min-width: 92rem) 84rem, 92vw',
};
---

<SiteLayout
  lang={lang}
  experience="photographer"
  title={`${content.title} - ${ui[lang].photography.metaTitleSuffix}`}
  description={content.description}
  image={gallery.cover}
  imageAlt={`${content.cardTitle}. ${content.description}`}
  pageType="article"
  schemaType="ImageGallery"
>
  <SiteHeader lang={lang} experience="photographer" />
  <main class="article-page series-page" id="main">
    <div class="series-masthead page-shell">
      <a class="inner-page__back" href={`/${lang}/ph/`}><Icon name="arrow-left" />{labels.back}</a>
      <p>{seriesNumber} / {seriesTotal}</p>
    </div>

    <header class="series-opening page-shell">
      <div class="series-opening__copy">
        <div>
          <p class="mono-label">{content.location}</p>
          <h1>{content.title}</h1>
        </div>
        <div class="series-opening__summary">
          <p>{content.description}</p>
          <p class="series-opening__facts">
            <span>{presentedImageCount} {ui[lang].photography.photographs}</span>
            {gallery.magazine && <span>{labels.magazineEdition}</span>}
          </p>
        </div>
      </div>

    </header>

    <div class="series-body page-shell">
      {gallery.magazine ? (
        <PhotoMagazine gallery={gallery} lang={lang} />
      ) : (
        <section class="series-gallery" aria-label={`${content.title} - ${ui[lang].photography.photographs}`}>
          {storyViewerSpreads.map(({ layout, photos }) => (
            <div class:list={['series-spread', `series-spread--${layout}`]}>
              {photos.map(({ image, alt, viewer, avifSrcset, number, filename }) => (
                <figure class="series-photo">
                  <button
                    class="series-photo__open"
                    type="button"
                    aria-label={`${labels.openFullscreen}: ${labels.photo} ${number} ${labels.from} ${content.title}`}
                    aria-haspopup="dialog"
                    aria-controls="photo-lightbox"
                    data-lightbox-open
                    data-lightbox-id={filename}
                    data-lightbox-src={viewer.src}
                    data-lightbox-alt={alt[lang]}
                  >
                    <picture>
                      <source type="image/avif" srcset={avifSrcset} sizes={imageSizes[layout]} />
                      <Image
                        src={image}
                        widths={[480, 800, 1200, 1600]}
                        sizes={imageSizes[layout]}
                        quality={number === 1 ? 84 : 80}
                        priority={number === 1}
                        loading={number <= openingImageCount ? 'eager' : 'lazy'}
                        alt={alt[lang]}
                        transition:name={number === 1 ? `gallery-cover-${gallery.slug}` : undefined}
                      />
                    </picture>
                    <span class="series-photo__expand"><Icon name="arrow-up-right" /></span>
                  </button>
                </figure>
              ))}
            </div>
          ))}
        </section>
      )}

      <footer>
        <nav class="series-path" aria-label={`${labels.previous} / ${labels.next}`}>
          <a class="series-path__link series-path__link--previous" href={`/${lang}/ph/${previousGallery.slug}/`} data-series-transition rel="prev">
            <Icon name="arrow-left" />
            <span><small>{labels.previous}</small><strong>{previousContent.title}</strong></span>
          </a>
          <a class="series-continuation" href={`/${lang}/ph/${nextGallery.slug}/`} data-series-transition rel="next">
            <div class="series-continuation__copy">
              <span>{labels.continueWith}</span>
              <strong>{nextContent.title}</strong>
              <p>{nextContent.location} · {nextGallery.images.length} {ui[lang].photography.photographs}</p>
              <Icon name="arrow-right" />
            </div>
            <figure>
              <Image
                src={nextGallery.cover}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 90rem) 39rem, (min-width: 60rem) 50vw, 100vw"
                quality={82}
                loading="lazy"
                alt={`${nextContent.cardTitle}. ${nextContent.description}`}
                transition:name={`gallery-cover-${nextGallery.slug}`}
              />
            </figure>
          </a>
        </nav>
      </footer>
    </div>
    {!gallery.magazine && <PhotoLightbox lang={lang} />}
  </main>
  <SiteFooter lang={lang} experience="photographer" />
</SiteLayout>
