---
import { Image } from 'astro:assets';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotoLightbox from '../../../components/PhotoLightbox.astro';
import { languages, ui, type Lang } from '../../../i18n/content';
import {
  getNextGallery,
  getPreviousGallery,
  photoGalleries,
  type PhotoGallery,
} from '../../../data/photoGalleries';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    photoGalleries.map((gallery) => ({
      params: { lang, slug: gallery.slug },
      props: { gallery },
    })),
  );
}

interface Props {
  gallery: PhotoGallery;
}

const { gallery } = Astro.props as Props;
const lang = Astro.params.lang as Lang;
const content = gallery.content[lang];
const previousGallery = getPreviousGallery(gallery.slug);
const nextGallery = getNextGallery(gallery.slug);
const previousContent = previousGallery.content[lang];
const nextContent = nextGallery.content[lang];
const labels = ui[lang].photography.series;
const galleryImages = [
  ...gallery.images.filter(({ filename }) => filename === gallery.coverFilename),
  ...gallery.images.filter(({ filename }) => filename !== gallery.coverFilename),
];
---

<SiteLayout
  lang={lang}
  experience="photographer"
  title={`${content.title} — David Barbosa`}
  description={content.description}
  image={gallery.cover.src}
  imageAlt={`${content.cardTitle}. ${content.description}`}
  pageType="article"
>
  <SiteHeader lang={lang} experience="photographer" />
  <main class="article-page series-page" id="main">
    <div class="page-shell">
      <a class="inner-page__back" href={`/${lang}/ph/`}><span aria-hidden="true">←</span>{labels.back}</a>
    </div>

    <header class="article-hero series-hero">
      <Image
        src={gallery.cover}
        widths={[480, 720, 1080, 1400]}
        sizes="100vw"
        quality={88}
        fetchpriority="high"
        alt={`${content.cardTitle}. ${content.description}`}
      />
      <div class="article-hero__copy page-shell">
        <p class="mono-label">{labels.kicker} · {content.location}</p>
        <h1>{content.title}</h1>
        <p>{content.description}</p>
      </div>
    </header>

    <article class="series-body page-shell">
      <nav class="series-body__meta" aria-label={`${labels.previous} / ${labels.next}`}>
        <div class="series-body__meta-group series-body__meta-group--previous">
          <a
            class="series-body__direction series-body__direction--previous"
            href={`/${lang}/ph/${previousGallery.slug}/`}
            aria-label={`${labels.previous}: ${previousContent.title}`}
            rel="prev"
          >
            <svg viewBox="0 0 32 16" aria-hidden="true">
              <path d="M30 8H3M9 2 3 8l6 6" />
            </svg>
            <span class="series-body__tooltip" aria-hidden="true">{previousContent.title}</span>
          </a>
          <p><strong>{gallery.images.length}</strong> {ui[lang].photography.photographs}</p>
        </div>
        <div class="series-body__meta-group series-body__meta-group--next">
          <p>
            <span class="series-body__source-label">{labels.source}</span>
            <span class="series-body__source-name" title={gallery.sourceFolder}>{gallery.sourceFolder}</span>
          </p>
          <a
            class="series-body__direction series-body__direction--next"
            href={`/${lang}/ph/${nextGallery.slug}/`}
            aria-label={`${labels.next}: ${nextContent.title}`}
            rel="next"
          >
            <svg viewBox="0 0 32 16" aria-hidden="true">
              <path d="M2 8h27m-6-6 6 6-6 6" />
            </svg>
            <span class="series-body__tooltip" aria-hidden="true">{nextContent.title}</span>
          </a>
        </div>
      </nav>

      <div class="series-gallery">
        {galleryImages.map(({ image, filename }, index) => {
          const number = index + 1;
          const alt = `${labels.photo} ${number} ${labels.from} ${content.title}`;
          const isLandscape = image.width > image.height;

          return (
            <figure class:list={['series-photo', (isLandscape || index % 9 === 7) && 'series-photo--wide']}>
              <button
                class="series-photo__open"
                type="button"
                aria-label={`${labels.openFullscreen}: ${alt}`}
                aria-haspopup="dialog"
                data-lightbox-open
                data-lightbox-src={image.src}
                data-lightbox-alt={alt}
                data-lightbox-filename={filename}
              >
                <Image
                  src={image}
                  widths={[480, 800, 1200, 1600]}
                  sizes={isLandscape ? '100vw' : '(min-width: 40rem) 50vw, 100vw'}
                  quality={86}
                  loading="lazy"
                  alt={alt}
                />
                <span class="series-photo__expand" aria-hidden="true">↗</span>
              </button>
              <figcaption>
                <span>{String(number).padStart(2, '0')} / {String(gallery.images.length).padStart(2, '0')}</span>
                <span aria-hidden="true">{filename}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>

      <a class="article-next" href={`/${lang}/ph/${nextGallery.slug}/`}>
        <span>{labels.next}</span>
        <strong>{nextContent.title} <span aria-hidden="true">→</span></strong>
      </a>
    </article>
    <PhotoLightbox lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
