---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotographyHome from '../../../components/PhotographyHome.astro';
import { copy, languages, type Lang } from '../../../i18n/content';
import { photoGalleries } from '../../../data/photoGalleries';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
const featuredGallery = photoGalleries[0];
const featuredContent = featuredGallery.content[lang];
---

<SiteLayout lang={lang} experience="photographer" title={t.meta.photoTitle} description={t.meta.photoDescription} image={featuredGallery.cover} imageAlt={`${featuredContent.cardTitle}. ${featuredContent.description}`} schemaType="CollectionPage">
  <SiteHeader lang={lang} experience="photographer" />
  <PhotographyHome lang={lang} />
  <SiteFooter lang={lang} />
</SiteLayout>
