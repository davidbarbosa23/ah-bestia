---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PhotographyHome from '../../../components/PhotographyHome.astro';
import { copy, languages, ui, type Lang } from '../../../i18n/content';
import photographerHero from '../../../assets/photography/photographer-hero.jpg';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<SiteLayout lang={lang} experience="photographer" title={t.meta.photoTitle} description={t.meta.photoDescription} image={photographerHero} imageAlt={ui[lang].metadata.photographerHeroSocialAlt} schemaType="CollectionPage">
  <SiteHeader lang={lang} experience="photographer" />
  <PhotographyHome lang={lang} />
  <SiteFooter lang={lang} />
</SiteLayout>

<script>
  let marqueeObserver: IntersectionObserver | undefined;
  let marqueeTween: {
    duration: () => number;
    kill: () => void;
    pause: () => void;
    progress: (value?: number) => number | unknown;
    resume: () => void;
    totalTime: (value?: number) => number | unknown;
  } | undefined;
  let marqueeControlTween: { kill: () => void } | undefined;
  let marqueeDrag: { kill: () => void } | undefined;
  let marqueeShift: ((direction: number) => void) | undefined;
  let marqueeController: AbortController | undefined;
  let photographyAnimations: Animation[] = [];
  let photographySetupVersion = 0;

  const teardownPhotographyAnimations = () => {
    photographySetupVersion += 1;
    marqueeObserver?.disconnect();
    marqueeObserver = undefined;
    marqueeController?.abort();
    marqueeController = undefined;
    marqueeTween?.kill();
    marqueeTween = undefined;
    marqueeControlTween?.kill();
    marqueeControlTween = undefined;
    marqueeDrag?.kill();
    marqueeDrag = undefined;
    marqueeShift = undefined;
    document.querySelector('[data-marquee-drag-proxy]')?.remove();
    document.querySelector('[data-photo-group][data-marquee-clone]')?.remove();
    document.querySelector('[data-horizontal-section]')?.removeAttribute('data-marquee-enhanced');
    document.querySelector('[data-photo-track]')?.removeAttribute('data-dragging');
    document.querySelector('[data-photo-track]')?.removeAttribute('style');
    photographyAnimations.forEach((animation) => animation.cancel());
    photographyAnimations = [];
  };

  const enhancePhotoMarquee = async (
    section: HTMLElement,
    track: HTMLElement,
    group: HTMLElement,
    setupVersion: number,
  ) => {
    const [{ default: gsap }, { Draggable }] = await Promise.all([
      import('gsap'),
      import('gsap/Draggable'),
    ]);
    if (setupVersion !== photographySetupVersion || !section.isConnected) return;
    gsap.registerPlugin(Draggable);

    const clone = group.cloneNode(true) as HTMLElement;
    clone.dataset.marqueeClone = '';
    clone.setAttribute('aria-hidden', 'true');
    clone.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => link.tabIndex = -1);
    track.append(clone);
    section.dataset.marqueeEnhanced = 'true';

    const distance = group.scrollWidth;
    marqueeTween = gsap.to(track, {
      x: -distance,
      duration: distance / 24,
      ease: 'none',
      repeat: -1,
    });
    marqueeTween.totalTime(marqueeTween.duration());

    const signal = marqueeController?.signal;
    if (!signal) return;
    let activeFrame: HTMLElement | undefined;
    let userPaused = false;

    const setActiveFrame = (frame?: HTMLElement) => {
      if (activeFrame === frame) return;
      activeFrame?.removeAttribute('data-active');
      activeFrame = frame;
      activeFrame?.setAttribute('data-active', 'true');
      if (!userPaused) {
        gsap.to(marqueeTween!, {
          timeScale: frame ? 0.12 : 1,
          duration: 0.55,
          ease: 'power2.out',
          overwrite: true,
        });
      }
    };

    track.addEventListener('pointerover', (event) => {
      if (!(event.target instanceof Element)) return;
      setActiveFrame(event.target.closest<HTMLElement>('.photo-frame') ?? undefined);
    }, { signal });

    track.addEventListener('pointerout', (event) => {
      if (!(event.target instanceof Element)) return;
      const frame = event.target.closest<HTMLElement>('.photo-frame');
      if (!frame || (event.relatedTarget instanceof Node && frame.contains(event.relatedTarget))) return;
      setActiveFrame(undefined);
    }, { signal });

    track.addEventListener('focusin', (event) => {
      if (!(event.target instanceof Element)) return;
      const frame = event.target.closest<HTMLElement>('.photo-frame');
      if (!frame) return;
      setActiveFrame(frame);
      marqueeTween?.pause();
    }, { signal });

    track.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        if (track.contains(document.activeElement)) return;
        setActiveFrame(undefined);
        if (!userPaused) marqueeTween?.resume();
      });
    }, { signal });

    const toggle = section.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.querySelector<HTMLElement>('[data-pause-label]')!.hidden = userPaused;
      toggle.querySelector<HTMLElement>('[data-play-label]')!.hidden = !userPaused;
      if (userPaused) marqueeTween?.pause();
      else marqueeTween?.resume();
    }, { signal });

    marqueeShift = (direction) => {
      if (!marqueeTween) return;
      const frame = group.querySelector<HTMLElement>('.photo-frame');
      if (!frame) return;

      const stepTime = frame.offsetWidth / 24;
      const loopDuration = marqueeTween.duration();
      let currentTime = Number(marqueeTween.totalTime());
      if (direction < 0 && currentTime - stepTime < 0) {
        currentTime += loopDuration;
        marqueeTween.totalTime(currentTime);
      }
      const targetTime = currentTime + direction * stepTime;
      marqueeTween.pause();
      marqueeControlTween?.kill();
      marqueeControlTween = gsap.to(marqueeTween, {
        totalTime: targetTime,
        duration: 0.55,
        ease: 'power2.out',
        overwrite: true,
        onComplete: () => {
          marqueeControlTween = undefined;
          if (!userPaused && !track.matches(':focus-within')) marqueeTween?.resume();
        },
      });
    };

    const dragProxy = document.createElement('div');
    dragProxy.dataset.marqueeDragProxy = '';
    section.append(dragProxy);
    let dragStartX = 0;
    let dragStartProgress = 0;
    let didDrag = false;

    [marqueeDrag] = Draggable.create(dragProxy, {
      type: 'x',
      trigger: track,
      dragClickables: true,
      minimumMovement: 4,
      onPress() {
        marqueeControlTween?.kill();
        marqueeControlTween = undefined;
        dragStartX = this.x;
        dragStartProgress = Number(marqueeTween?.progress() ?? 0);
        didDrag = false;
        marqueeTween?.pause();
        track.dataset.dragging = 'true';
      },
      onDrag() {
        didDrag = true;
        const progress = dragStartProgress - (this.x - dragStartX) / distance;
        marqueeTween?.progress(gsap.utils.wrap(0, 1, progress));
      },
      onRelease() {
        const shouldResume = didDrag || !track.matches(':focus-within');
        const focusedElement = document.activeElement;
        if (didDrag && focusedElement instanceof HTMLElement && track.contains(focusedElement)) {
          focusedElement.blur();
        }
        track.removeAttribute('data-dragging');
        didDrag = false;
        if (!userPaused && shouldResume) marqueeTween?.resume();
      },
    });
  };

  const setupPhotographyAnimations = () => {
    teardownPhotographyAnimations();
    const hero = document.querySelector('.photo-hero');
    if (!hero) return;

    const allowMotion = document.documentElement.dataset.languageTransition !== 'true'
      && window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (allowMotion) {
      const easing = 'cubic-bezier(0.16, 1, 0.3, 1)';
      const animateIntro = (selector: string, transform: string, duration: number, delay: number, stagger = 0) => {
        document.querySelectorAll<HTMLElement>(selector).forEach((element, index) => {
          const animation = element.animate(
            [
              { opacity: 0, transform },
              { opacity: 1, transform: 'none' },
            ],
            { duration, delay: delay + index * stagger, easing, fill: 'backwards' },
          );
          photographyAnimations.push(animation);
        });
      };

      animateIntro('.photo-hero .status-line', 'translateY(10px)', 360, 0);
      animateIntro('.photo-hero h1 span', 'translateY(24%)', 720, 80, 80);
      animateIntro('.photo-hero__copy > p:last-child', 'translateY(12px)', 480, 260);
    }

    const section = document.querySelector<HTMLElement>('[data-horizontal-section]');
    const track = section?.querySelector<HTMLElement>('[data-photo-track]');
    const group = track?.querySelector<HTMLElement>('[data-photo-group]');
    if (!section || !track || !group) return;

    marqueeController = new AbortController();
    const { signal } = marqueeController;
    section.querySelectorAll<HTMLButtonElement>('[data-carousel-direction]').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = Number(button.dataset.carouselDirection);
        if (marqueeShift) {
          marqueeShift(direction);
          return;
        }

        const frame = group.querySelector<HTMLElement>('.photo-frame');
        if (!frame) return;
        const gap = Number.parseFloat(getComputedStyle(group).columnGap) || 0;
        const step = frame.offsetWidth + gap;
        const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
        const atStart = track.scrollLeft <= step / 2;
        const atEnd = track.scrollLeft >= maxScroll - step / 2;
        const target = direction < 0 && atStart
          ? maxScroll
          : direction > 0 && atEnd
            ? 0
            : track.scrollLeft + direction * step;

        track.scrollTo({
          left: target,
          behavior: allowMotion ? 'smooth' : 'auto',
        });
      }, { signal });
    });

    const supportsEnhancement = window.matchMedia(
      '(min-width: 60rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
    ).matches;
    if (!supportsEnhancement) return;

    const setupVersion = photographySetupVersion;
    marqueeObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      marqueeObserver?.disconnect();
      marqueeObserver = undefined;
      void enhancePhotoMarquee(section, track, group, setupVersion);
    }, { rootMargin: '50% 0px' });
    marqueeObserver.observe(section);
  };

  document.addEventListener('astro:page-load', setupPhotographyAnimations);
</script>
