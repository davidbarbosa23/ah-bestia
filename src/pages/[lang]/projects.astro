---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { copy, languages, type Lang } from '../../i18n/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = copy[lang];
---

<SiteLayout lang={lang} title={t.meta.projectsTitle} description={t.meta.projectsDescription}>
  <SiteHeader lang={lang} />
  <main class="inner-page page-shell" id="main">
    <a class="inner-page__back" href={`/${lang}`}><span aria-hidden="true">←</span>{t.projects.back}</a>
    <header class="inner-page__hero">
      <h1>{t.projects.title}</h1>
      <p>{t.projects.intro}</p>
    </header>

    <article class="project-study">
      <div class="project-study__visual" aria-label="Fixed Gear Calculator ratio 2.82">
        <div class="ratio-display"><strong>2.82</strong><span>48T / 17T · 700C</span></div>
      </div>
      <dl class="project-specs">
        <div><dt>{t.projects.challenge}</dt><dd>{t.projects.challengeText}</dd></div>
        <div><dt>{t.projects.answer}</dt><dd>{t.projects.answerText}</dd></div>
        <div><dt>{t.projects.status}</dt><dd>{t.projects.statusText}</dd></div>
        <div><dt>{t.projects.stack}</dt><dd>{t.projects.stackText}</dd></div>
      </dl>
      <p class="project-study__cta">
        <a class="button button--primary" href={`mailto:davidbarbosa.dev@gmail.com?subject=${encodeURIComponent(t.dev.projectName)}`}>{t.projects.visit}<span aria-hidden="true">↗</span></a>
      </p>
    </article>
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
