---
const destination = '/en/dev/';
const canonical = new URL(destination, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>David Barbosa</title>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
      window.location.replace('/en/dev/');
    </script>
    <style is:inline>
      html,
      body {
        min-height: 100%;
        margin: 0;
        background: #111318;
      }

      html[data-theme='light'],
      html[data-theme='light'] body {
        background: #f7f8fb;
      }
    </style>
  </head>
  <body></body>
</html>
